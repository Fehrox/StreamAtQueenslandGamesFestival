      );
      const selectedProfileLinkIcon = document.querySelector<HTMLImageElement>(
        "[data-selected-profile-link-icon]",
      );
      const mobileSelectedName = document.querySelector("[data-mobile-selected-name]");
      const mobileSelectedPortrait = document.querySelector("[data-mobile-selected-portrait]");
