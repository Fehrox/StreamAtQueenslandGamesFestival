      const verificationResultCloseButtons = document.querySelectorAll<HTMLButtonElement>(
        "[data-verification-result-close]",
      );
      const verificationResultTitle = document.querySelector<HTMLElement>(
        "[data-verification-result-title]",
      );
      const verificationResultStatus = document.querySelector<HTMLElement>(
        "[data-verification-result-status]",
      );
      const verificationResultCopy = document.querySelector<HTMLElement>(
        "[data-verification-result-copy]",
      );
      const attendanceConfirmedModal = document.querySelector<HTMLDialogElement>(
        "[data-attendance-confirmed-modal]",
      );
      const attendanceConfirmedCloseButtons = document.querySelectorAll<HTMLButtonElement>(
        "[data-attendance-confirmed-close]",
      );
      const attendanceConfirmedPortrait = document.querySelector<HTMLElement>(
        "[data-attendance-confirmed-portrait]",
      );
      const attendanceConfirmedHeading = document.querySelector<HTMLElement>(
        "[data-attendance-confirmed-heading]",
      );
      const attendanceConfirmedCopy = document.querySelector<HTMLElement>(
        "[data-attendance-confirmed-copy]",
      );
      const attendanceConfirmedNote = document.querySelector<HTMLElement>(
        "[data-attendance-confirmed-note]",
      );
      const streamerVerificationProfileData = document.querySelector<HTMLScriptElement>(
        "[data-streamer-verification-profiles]",
      );
      const twitchClientId = import.meta.env.PUBLIC_TWITCH_CLIENT_ID || "";
      const twitchRedirectUri = "https://streamatqueenslandgamesfestival.com";
      const twitchRedirectUriFallback = "https://streamatqueenslandgamesfestival.com/";
      const twitchRedirectUriAttempts = [twitchRedirectUri, twitchRedirectUriFallback];
      const pendingTwitchVerificationStorageKey = "qgfInvite:pendingTwitchVerification";
      const confirmationDetailsStorageKey = "qgfInvite:confirmationDetails";
      const festivalUrl = "https://www.queenslandgamesfestival.com/";
      const readyOverlayExitMs = 280;
      const initialCreatorSelectionDelayMs = 700;
      let readyOverlayExitTimer: number | undefined;
      let confirmSubmitCloseTimer: number | undefined;
      let selectedStreamerId: string | undefined;
      let isStartingTwitchVerification = false;
      type UrlUpdateMode = "none" | "push" | "replace";
      const attendanceConfirmedPortraitFallbackClasses = [
        "big-avatar-head",
        "big-avatar-body",
        "big-avatar-arm",
      ];
      const portraitFadeMs = 110;
      let hoverPreviewClearTimeout: number | undefined;
      let activeStreamerImageMode: StreamerImageMode = "styled";
      let hoverPreviewCard: HTMLElement | undefined;

      const applyImageFallback = (img: HTMLImageElement) => {
        const fallbackImage = img.getAttribute("data-fallback-src") || "";

        if (
          !fallbackImage ||
          img.getAttribute("data-fallback-active") === "true" ||
          img.getAttribute("src") === fallbackImage
        ) {
          return;
        }

        img.setAttribute("data-fallback-active", "true");
        img.src = fallbackImage;
      };

      const wireImageFallback = (img: HTMLImageElement, checkCurrent = true) => {
        img.addEventListener("error", () => applyImageFallback(img), { once: false });

        if (checkCurrent && img.complete && img.naturalWidth === 0) {
          applyImageFallback(img);
        }
      };

      document
        .querySelectorAll<HTMLImageElement>("img[data-fallback-src]")
        .forEach((img) => wireImageFallback(img));
      let pendingConfirmationDetails: ConfirmationDetails | undefined;

      const getStreamerImageFromCard = (
        card: HTMLElement,
        imageMode: StreamerImageMode,
      ): StreamerImageTarget => {
        const profileImage =
          card.getAttribute("data-streamer-profile-image") ||
          card.getAttribute("data-streamer-fallback-image") ||
          "";
        const styledImage = card.getAttribute("data-streamer-styled-image") || "";
        const nintendoImage = card.getAttribute("data-streamer-nintendo-image") || "";
        const image =
          imageMode === "profile"
            ? profileImage
            : imageMode === "styled"
              ? styledImage || profileImage
              : nintendoImage || styledImage || profileImage;

        return {
          image,
          fallbackImage: profileImage,
          isGeneratedVariant: Boolean(image && profileImage && image !== profileImage),
        };
      };

      const setStreamerImageElement = (
        img: HTMLImageElement,
        { image, fallbackImage, isGeneratedVariant }: StreamerImageTarget,
      ) => {
        img.removeAttribute("data-fallback-active");

        if (fallbackImage && fallbackImage !== image) {
          img.setAttribute("data-fallback-src", fallbackImage);
        } else {
          img.removeAttribute("data-fallback-src");
        }

        if (isGeneratedVariant) {
          img.setAttribute("data-styled-streamer-image", "true");
        } else {
          img.removeAttribute("data-styled-streamer-image");
        }

        if (img.getAttribute("src") !== image) {
          img.src = image;
        }
      };

      const updateStreamerCardImage = (
        card: HTMLElement,
        imageMode: StreamerImageMode,
      ) => {
        const streamerImageTarget = getStreamerImageFromCard(card, imageMode);
        card.setAttribute("data-streamer-image", streamerImageTarget.image);
        card.setAttribute(
          "data-streamer-fallback-image",
          streamerImageTarget.fallbackImage,
        );

        const img = card.querySelector<HTMLImageElement>(
          ".portrait img, .mobile-portrait img",
        );

        if (!img || !streamerImageTarget.image) {
          return;
        }

        setStreamerImageElement(img, streamerImageTarget);
      };

      const parseStreamerVerificationProfiles = (): StreamerVerificationProfile[] => {
        if (!streamerVerificationProfileData?.textContent) {
          return [];
        }

        try {
          const profiles = JSON.parse(streamerVerificationProfileData.textContent);

          if (!Array.isArray(profiles)) {
            return [];
          }

          return profiles
            .filter(
              (profile): profile is StreamerVerificationProfile =>
                typeof profile === "object" &&
                profile !== null &&
                typeof profile.id === "string" &&
                typeof profile.name === "string" &&
                typeof profile.image === "string" &&
                typeof profile.fallbackImage === "string" &&
                typeof profile.nintendoImage === "string" &&
                typeof profile.profileImage === "string" &&
                typeof profile.profileUrl === "string" &&
                typeof profile.styledImage === "string" &&
                typeof profile.twitchHandle === "string",
            )
            .map((profile) => ({
              id: profile.id,
              name: profile.name,
              image: profile.image,
              fallbackImage: profile.fallbackImage,
              nintendoImage: profile.nintendoImage,
              profileImage: profile.profileImage,
              profileUrl: profile.profileUrl,
              styledImage: profile.styledImage,
              twitchHandle: profile.twitchHandle,
            }));
        } catch {
          return [];
        }
      };

      const clientStreamerVerificationProfiles = parseStreamerVerificationProfiles();

      const hasSelection = () =>
        document.documentElement.classList.contains("has-streamer-selected");

      const eventStartTime = new Date("2026-06-26T00:00:00+10:00").getTime();
      const millisecondsPerDay = 24 * 60 * 60 * 1000;
      const daysPerWeek = 7;

      const formatCountdownPart = (value: number, unit: string) =>
        `${value.toLocaleString("en-AU")} ${unit}${value === 1 ? "" : "s"}`;

      const updateEventCountdown = () => {
        if (!eventCountdown) {
          return;
        }

        const remainingMilliseconds = Math.max(0, eventStartTime - Date.now());

        if (remainingMilliseconds === 0) {
          eventCountdown.textContent = "Event is underway";
          return;
        }

        const remainingDays = Math.floor(remainingMilliseconds / millisecondsPerDay);
        const weeks = Math.floor(remainingDays / daysPerWeek);
        const days = remainingDays % daysPerWeek;

        eventCountdown.textContent = `In ${formatCountdownPart(weeks, "week")} / ${formatCountdownPart(days, "day")}`;
      };

      updateEventCountdown();
      window.setInterval(updateEventCountdown, 60 * 1000);

      const confirmationDialogs = [
        eventInfoModal,
        confirmModal,
        verificationChoiceModal,
        verificationResultModal,
        attendanceConfirmedModal,
      ];

      const isConfirmationDialogOpen = () =>
        confirmationDialogs.some((dialog) => dialog instanceof HTMLDialogElement && dialog.open);

      const syncConfirmationDialogClass = () => {
        document.documentElement.classList.toggle(
          "has-confirm-modal-open",
          isConfirmationDialogOpen(),
        );
      };

      const openDialog = (dialog: HTMLDialogElement | null) => {
        if (!(dialog instanceof HTMLDialogElement)) {
          return;
        }

        document.documentElement.classList.add("has-confirm-modal-open");

        if (!dialog.open) {
          dialog.showModal();
        }
      };

      const closeDialog = (dialog: HTMLDialogElement | null) => {
        if (dialog instanceof HTMLDialogElement && dialog.open) {
          dialog.close();
        }
      };

      const normalizeTwitchLogin = (value = "") =>
        value.trim().replace(/^@+/, "").toLowerCase();

      const formatTwitchHandle = (value = "") => {
        const login = normalizeTwitchLogin(value);
        return login ? `@${login}` : "";
      };

      const getStreamerProfile = (streamerId = "") =>
        clientStreamerVerificationProfiles.find((profile) => profile.id === streamerId);

      const getStreamerProfileByTwitchLogin = (twitchLogin = "") => {
        const normalizedLogin = normalizeTwitchLogin(twitchLogin);

        return clientStreamerVerificationProfiles.find(
          (profile) => normalizeTwitchLogin(profile.twitchHandle) === normalizedLogin,
        );
      };

      const getDetailsForStreamerProfile = (
        details: ConfirmationDetails,
        streamerProfile: StreamerVerificationProfile,
      ): ConfirmationDetails => ({
        ...details,
        creatorId: streamerProfile.id,
        creatorName: streamerProfile.name,
        expectedTwitchHandle: normalizeTwitchLogin(streamerProfile.twitchHandle),
      });

      const writeSessionJson = (key: string, value: unknown) => {
        try {
          window.sessionStorage.setItem(key, JSON.stringify(value));
          return true;
        } catch {
          return false;
        }
      };

      const readSessionJson = <T,>(key: string): T | undefined => {
        try {
          const value = window.sessionStorage.getItem(key);
          return value ? (JSON.parse(value) as T) : undefined;
        } catch {
          return undefined;
        }
      };

      const removeSessionItem = (key: string) => {
        try {
          window.sessionStorage.removeItem(key);
        } catch {
          return;
        }
      };

      const saveConfirmationDetails = (details: ConfirmationDetails) =>
        writeSessionJson(confirmationDetailsStorageKey, details);

      const collectConfirmationDetails = (): ConfirmationDetails | undefined => {
        if (!(confirmForm instanceof HTMLFormElement)) {
          return undefined;
        }

        const formData = new FormData(confirmForm);
        const creatorId = String(formData.get("creator") || selectedStreamerId || "");
        const streamerProfile = getStreamerProfile(creatorId);

        if (!creatorId || !streamerProfile) {
          return undefined;
        }

        const answers: Record<string, string> = {};

        formData.forEach((value, key) => {
          if (key === "creator" || key === "creatorEmail" || key === "_gotcha") {
            return;
          }

          answers[key] = typeof value === "string" ? value : value.name;
        });

        return {
          creatorId,
          creatorName: streamerProfile.name,
          creatorEmail: String(formData.get("creatorEmail") || "").trim(),
          answers,
          expectedTwitchHandle: normalizeTwitchLogin(streamerProfile.twitchHandle),
          savedAt: new Date().toISOString(),
        };
      };

      const createOAuthState = () => {
        if (window.crypto?.getRandomValues) {
          const bytes = new Uint8Array(16);
          window.crypto.getRandomValues(bytes);
          return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
        }

        return `${Math.random().toString(36).slice(2)}${Date.now().toString(36)}`;
      };

      const setVerificationChoiceState = (details: ConfirmationDetails) => {
        const expectedHandle = formatTwitchHandle(details.expectedTwitchHandle);
        const hasTwitchHandle = expectedHandle.length > 0;
        const hasTwitchClientId = twitchClientId.length > 0;
        const canVerifyWithTwitch = hasTwitchHandle && hasTwitchClientId;

        if (verificationChoiceCopy instanceof HTMLElement) {
          verificationChoiceCopy.textContent = expectedHandle
            ? `Confirm ${details.creatorName} with ${expectedHandle}, or continue without account verification.`
            : `Confirm ${details.creatorName} without account verification.`;
        }

        if (verificationChoiceWarning instanceof HTMLElement) {
          let warning = "";

          if (!hasTwitchHandle && !hasTwitchClientId) {
            warning =
              "Twitch verification needs a configured Twitch handle and PUBLIC_TWITCH_CLIENT_ID.";
          } else if (!hasTwitchHandle) {
            warning = "This creator does not have a Twitch handle configured yet.";
          } else if (!hasTwitchClientId) {
            warning =
              "Twitch verification is not configured for this deployment. Set PUBLIC_TWITCH_CLIENT_ID.";
          }

          verificationChoiceWarning.textContent = warning;
          verificationChoiceWarning.hidden = warning.length === 0;
        }

        if (confirmWithTwitchButton instanceof HTMLButtonElement) {
          confirmWithTwitchButton.disabled = !canVerifyWithTwitch;
          confirmWithTwitchButton.setAttribute("aria-disabled", String(!canVerifyWithTwitch));
          confirmWithTwitchButton.title = canVerifyWithTwitch
            ? ""
            : "Twitch verification is unavailable for this selection.";
        }
      };

      const setTwitchVerificationStarting = (isStarting: boolean) => {
        isStartingTwitchVerification = isStarting;

        if (!(confirmWithTwitchButton instanceof HTMLButtonElement)) {
          return;
        }

        confirmWithTwitchButton.disabled = isStarting;
        confirmWithTwitchButton.setAttribute("aria-disabled", String(isStarting));

        if (confirmWithTwitchButtonIdleText) {
          confirmWithTwitchButton.textContent = isStarting
            ? "Opening Twitch..."
            : confirmWithTwitchButtonIdleText;
        }
      };

      const resultTitles: Record<VerificationResultStatus, string> = {
        verified: "Verified",
        mismatch: "Account Mismatch",
        unverified: "Unverified Confirmation",
        cancelled: "Verification Cancelled",
        failed: "Verification Failed",
      };

      const resultLabels: Record<VerificationResultStatus, string> = {
        verified: "Verified",
        mismatch: "Mismatch",
        unverified: "Unverified",
        cancelled: "Cancelled",
        failed: "Verification Failed",
      };

      const openVerificationResult = (status: VerificationResultStatus, message: string) => {
        closeDialog(confirmModal);
        closeDialog(verificationChoiceModal);
        closeDialog(attendanceConfirmedModal);

        if (verificationResultModal instanceof HTMLDialogElement) {
          verificationResultModal.setAttribute("data-verification-status", status);
        }

        if (verificationResultTitle instanceof HTMLElement) {
          verificationResultTitle.textContent = resultTitles[status];
        }

        if (verificationResultStatus instanceof HTMLElement) {
          verificationResultStatus.textContent = resultLabels[status];
        }

        if (verificationResultCopy instanceof HTMLElement) {
          verificationResultCopy.textContent = message;
        }

        openDialog(verificationResultModal);
      };

      const setAttendanceConfirmedPortrait = (streamerProfile: StreamerVerificationProfile) => {
        if (!(attendanceConfirmedPortrait instanceof HTMLElement)) {
          return;
        }

        attendanceConfirmedPortrait.replaceChildren();
        attendanceConfirmedPortrait.classList.toggle(
          "attendance-confirmed-portrait-has-image",
          Boolean(streamerProfile.image),
        );

        if (streamerProfile.image) {
          const img = document.createElement("img");
          img.alt = "";
          img.decoding = "async";
          img.src = streamerProfile.image;

          if (streamerProfile.fallbackImage) {
            img.setAttribute("data-fallback-src", streamerProfile.fallbackImage);
            wireImageFallback(img, false);
          }

          attendanceConfirmedPortrait.append(img);
          return;
        }

        attendanceConfirmedPortraitFallbackClasses.forEach((className) => {
          const span = document.createElement("span");
          span.className = className;
          attendanceConfirmedPortrait.append(span);
        });
      };

      const openAttendanceConfirmedDialog = (
        streamerProfile: StreamerVerificationProfile,
        returnedLogin: string,
        originalDetails: ConfirmationDetails,
      ) => {
        const formattedLogin = formatTwitchHandle(returnedLogin);
        const selectedDifferentStreamer = streamerProfile.id !== originalDetails.creatorId;

        closeDialog(confirmModal);
        closeDialog(verificationChoiceModal);
        closeDialog(verificationResultModal);

        if (attendanceConfirmedHeading instanceof HTMLElement) {
          attendanceConfirmedHeading.textContent = `Confirmed ${streamerProfile.name}`;
        }

        if (attendanceConfirmedCopy instanceof HTMLElement) {
          attendanceConfirmedCopy.textContent = `Confirmed ${streamerProfile.name} with ${formattedLogin}.`;
        }

        if (attendanceConfirmedNote instanceof HTMLElement) {
          attendanceConfirmedNote.textContent = selectedDifferentStreamer
            ? `You selected ${originalDetails.creatorName}, but Twitch returned ${formattedLogin}. We matched that account to ${streamerProfile.name}.`
            : "";
          attendanceConfirmedNote.hidden = !selectedDifferentStreamer;
        }

        setAttendanceConfirmedPortrait(streamerProfile);
        openDialog(attendanceConfirmedModal);
      };

      const openVerificationChoiceModal = (details: ConfirmationDetails) => {
        pendingConfirmationDetails = details;
        setVerificationChoiceState(details);
        closeDialog(confirmModal);
        openDialog(verificationChoiceModal);
      };

      const validateTwitchAccessToken = async (accessToken: string) => {
        const response = await fetch("https://id.twitch.tv/oauth2/validate", {
          headers: {
            Authorization: `OAuth ${accessToken}`,
          },
        });

        if (!response.ok) {
          throw new Error("Twitch token validation failed.");
        }

        const validation = (await response.json()) as {
          client_id?: string;
          login?: string;
        };

        if (validation.client_id !== twitchClientId) {
          throw new Error("Twitch token was issued for a different client.");
        }

        return validation;
      };

      const fetchTwitchProfileImage = async (accessToken: string, login: string) => {
        const normalizedLogin = normalizeTwitchLogin(login);

        if (!normalizedLogin) {
          return "";
        }

        const userUrl = new URL("https://api.twitch.tv/helix/users");
        userUrl.searchParams.set("login", normalizedLogin);

        try {
          const response = await fetch(userUrl.toString(), {
            headers: {
              Authorization: `Bearer ${accessToken}`,
              "Client-Id": twitchClientId,
            },
          });

          if (!response.ok) {
            return "";
          }

          const payload = (await response.json()) as {
            data?: Array<{
              login?: string;
              profile_image_url?: string;
            }>;
          };
          const profile = payload.data?.find(
            (user) => normalizeTwitchLogin(user.login || "") === normalizedLogin,
          );

          return typeof profile?.profile_image_url === "string"
            ? profile.profile_image_url
            : "";
        } catch {
          return "";
        }
      };

      const withConfirmedProfileImage = (
        streamerProfile: StreamerVerificationProfile,
        twitchProfileImage: string,
      ): StreamerVerificationProfile => ({
        ...streamerProfile,
        image: twitchProfileImage || streamerProfile.image,
      });

      const getTwitchRedirectMismatchMessage = (
        authErrorDescription: string | null,
        attemptedRedirectUris: string[],
      ) => {
        const attemptedRedirectText = attemptedRedirectUris.join(" then ");
        const description = authErrorDescription ? ` Twitch returned: ${authErrorDescription}.` : "";

        return `Twitch rejected the OAuth Redirect URL.${description} The deployed site tried ${attemptedRedirectText} for client ID ${twitchClientId}. In the matching Twitch developer app, register ${twitchRedirectUri} as an OAuth Redirect URL and confirm GitHub PUBLIC_TWITCH_CLIENT_ID uses that same app.`;
      };

      const getNextTwitchRedirectUri = (pendingVerification: PendingTwitchVerification) => {
        const attemptedRedirectUris = pendingVerification.attemptedRedirectUris || [
          pendingVerification.redirectUri,
        ];

        return twitchRedirectUriAttempts.find(
          (redirectUri) => !attemptedRedirectUris.includes(redirectUri),
        );
      };

      const startTwitchVerification = (
        details: ConfirmationDetails,
        redirectUri = twitchRedirectUri,
        attemptedRedirectUris = [redirectUri],
      ) => {
        if (isStartingTwitchVerification) {
          return;
        }

        setTwitchVerificationStarting(true);

        if (!twitchClientId || !details.expectedTwitchHandle) {
          setTwitchVerificationStarting(false);
          openVerificationResult(
            "failed",
            "Twitch verification is unavailable for this selection.",
          );
          return;
        }

        const state = createOAuthState();
        const pendingVerification: PendingTwitchVerification = {
          ...details,
          state,
          redirectUri,
          attemptedRedirectUris,
        };

        if (!writeSessionJson(pendingTwitchVerificationStorageKey, pendingVerification)) {
          setTwitchVerificationStarting(false);
          openVerificationResult(
            "failed",
            "The browser could not store the Twitch verification request.",
          );
          return;
        }

        const authorizeUrl = new URL("https://id.twitch.tv/oauth2/authorize");
        authorizeUrl.searchParams.set("client_id", twitchClientId);
        authorizeUrl.searchParams.set("redirect_uri", redirectUri);
        authorizeUrl.searchParams.set("response_type", "token");
        authorizeUrl.searchParams.set("state", state);
        authorizeUrl.searchParams.set("force_verify", "true");
        window.location.assign(authorizeUrl.toString());
      };

      const setSelectedStreamerName = (streamerName: string) => {
        if (selectedName instanceof HTMLElement) {
          selectedName.textContent = streamerName;
        }

        if (mobileSelectedName instanceof HTMLElement) {
          mobileSelectedName.textContent = streamerName;
        }
      };

      const profilePlatformDetails = {
        twitch: {
          icon: "/icons/TwitchGlitchWhite.svg",
          label: "Twitch",
        },
        youtube: {
          icon: "/icons/YouTubeWhite.svg",
          label: "YouTube",
        },
      } as const;

      type ProfilePlatform = keyof typeof profilePlatformDetails;

      const isProfilePlatform = (value: string): value is ProfilePlatform =>
        Object.prototype.hasOwnProperty.call(profilePlatformDetails, value);

      const setSelectedStreamerProfileLink = (
        streamerName = "",
        profileUrl = "",
        profilePlatform = "",
      ) => {
        if (!(selectedProfileLink instanceof HTMLAnchorElement)) {
          return;
        }

        const platform = isProfilePlatform(profilePlatform) ? profilePlatform : "";
        const hasProfileLink = profileUrl.length > 0 && platform.length > 0;
        selectedProfileLink.toggleAttribute(
          "data-profile-link-disabled",
          !hasProfileLink,
        );
        selectedProfileLink.setAttribute("aria-disabled", String(!hasProfileLink));
        selectedProfileLink.tabIndex = hasProfileLink ? 0 : -1;

        if (!hasProfileLink) {
          selectedProfileLink.removeAttribute("href");
          selectedProfileLink.removeAttribute("data-profile-platform");
          selectedProfileLink.setAttribute("aria-label", "Open selected creator profile");
          selectedProfileLink.title = "Open creator profile";
          return;
        }

        const details = profilePlatformDetails[platform as ProfilePlatform];

        selectedProfileLink.href = profileUrl;
        selectedProfileLink.setAttribute("data-profile-platform", platform);
        selectedProfileLink.setAttribute(
          "aria-label",
          `Open ${streamerName}'s ${details.label} page`,
        );
        selectedProfileLink.title = `Open ${streamerName}'s ${details.label} page`;

        if (selectedProfileLinkIcon instanceof HTMLImageElement) {
          selectedProfileLinkIcon.src = details.icon;
        }
      };

      const setSelectedStreamerProfileIcon = (profileIcon: string) => {
        selectedProfileIcons.forEach((icon) => {
          const currentIcon =
            icon.getAttribute("data-current-profile-icon") ||
            icon.getAttribute("src") ||
            "";

          if (!profileIcon) {
            icon.hidden = true;
            icon.removeAttribute("src");
            icon.setAttribute("data-current-profile-icon", "");
            icon.classList.remove("profile-cutout-icon-ready");
            return;
          }

          icon.hidden = false;

          if (currentIcon === profileIcon) {
            icon.classList.add("profile-cutout-icon-ready");
            return;
          }

          icon.classList.remove("profile-cutout-icon-ready");
          icon.setAttribute("data-current-profile-icon", profileIcon);
          icon.src = profileIcon;

          window.requestAnimationFrame(() => {
            icon.classList.add("profile-cutout-icon-ready");
          });
        });
      };

      const setCursorOverStreamerCard = (isOver: boolean) => {
        document.documentElement.classList.toggle("custom-cursor-over-streamer-card", isOver);
      };

      const setTwitchConfirmButtonVisibility = (streamerName = "") => {
        const hasStreamerName = streamerName.length > 0;

        twitchConfirmButtons.forEach((button) => {
          button.hidden = !hasStreamerName;
          button.setAttribute("aria-disabled", String(!hasStreamerName));
          button.setAttribute(
            "aria-label",
            hasStreamerName
              ? `Confirm ${streamerName} with Twitch`
              : "Confirm selected creator with Twitch",
          );
        });
      };

      const syncConfirmStreamerSelect = () => {
        if (confirmStreamerSelect instanceof HTMLSelectElement && selectedStreamerId) {
          confirmStreamerSelect.value = selectedStreamerId;
        }
      };

      const openConfirmModal = () => {
        if (!hasSelection() || !(confirmModal instanceof HTMLDialogElement)) {
          return;
        }

        syncConfirmStreamerSelect();
        openDialog(confirmModal);
      };

      const closeConfirmModal = () => {
        closeDialog(confirmModal);
      };

      const setConfirmSubmitMessage = (text = "", status = "") => {
        if (!(confirmSubmitMessage instanceof HTMLElement)) {
          return;
        }

        confirmSubmitMessage.textContent = text;

        if (status) {
          confirmSubmitMessage.dataset.status = status;
        } else {
          delete confirmSubmitMessage.dataset.status;
        }
      };

      const setConfirmSubmitting = (isSubmitting: boolean) => {
        if (confirmSubmitButton instanceof HTMLButtonElement) {
          confirmSubmitButton.disabled = isSubmitting;

          if (isSubmitting) {
            confirmSubmitButton.setAttribute("aria-busy", "true");
          } else {
            confirmSubmitButton.removeAttribute("aria-busy");
          }
        }

        if (confirmSubmitLabel instanceof HTMLElement) {
          confirmSubmitLabel.textContent = isSubmitting ? "Saving..." : "Save Details";
        }

        if (confirmSubmitSpinner instanceof HTMLElement) {
          confirmSubmitSpinner.hidden = !isSubmitting;
        }
      };

      const isValidEmail = (email: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);

      const submitEoiDetails = async (
        details: ConfirmationDetails,
        twitchOAuthLogin = "",
      ) => {
        if (!eoiFormUrl) {
          openVerificationResult("failed", "EOI saving is not configured yet.");
          return false;
        }

        const submissionData = new FormData();
        submissionData.append("creatorId", details.creatorId);
        submissionData.append("creatorName", details.creatorName);
        submissionData.append("creatorEmail", details.creatorEmail.trim().toLowerCase());
        submissionData.append("deploymentId", eoiDeploymentId);
        submissionData.append("source", "qgf-invite");
        submissionData.append("twitchOAuthLogin", twitchOAuthLogin);

        eoiAnswerFieldNames.forEach((fieldName) => {
          submissionData.append(fieldName, details.answers[fieldName] || "");
        });

        try {
          const response = await fetch(eoiFormUrl, {
            method: "POST",
            mode: "no-cors",
            body: submissionData,
          });

          const isOpaque = response.type === "opaque" || response.status === 0;
          let data: { ok?: boolean; message?: string; error?: string } = {};

          if (!isOpaque) {
            data = await response.json().catch(() => ({}));
          }

          const ok = isOpaque || (response.ok && (data.ok === undefined || data.ok));

          if (!ok) {
            openVerificationResult(
              "failed",
              data.error || "Something went wrong. Try again?",
            );
            return false;
          }

          return true;
        } catch {
          openVerificationResult("failed", "Network error. Please try again.");
          return false;
        }
      };

      const setBrowserUrl = (targetUrl: URL, mode: UrlUpdateMode) => {
        if (mode === "none" || targetUrl.href === window.location.href) {
          return;
        }

        if (mode === "replace") {
          window.history.replaceState({ selectedStreamerId }, "", targetUrl);
          return;
        }

        window.history.pushState({ selectedStreamerId }, "", targetUrl);
      };

      const getRootSelectionUrl = () => {
        const url = new URL(window.location.href);
        url.pathname = "/";
        url.search = "";
        url.hash = "";

        return url;
      };

      const getStreamerSelectionUrl = (card: HTMLElement) => {
        const slug = card.getAttribute("data-streamer-url-slug") || "";

        if (!slug) {
          return undefined;
        }

        const url = new URL(window.location.href);
        url.pathname = `/${slug}`;
        url.search = "";
        url.hash = "";

        return url;
      };

      const updateUrlForSelectedStreamer = (card: HTMLElement, mode: UrlUpdateMode) => {
        const url = getStreamerSelectionUrl(card);

        if (url) {
          setBrowserUrl(url, mode);
          return;
        }

        updateUrlForClearedSelection(mode);
      };

      const updateUrlForClearedSelection = (mode: UrlUpdateMode) => {
        setBrowserUrl(getRootSelectionUrl(), mode);
      };

      const selectStreamerById = (streamerId: string, urlMode: UrlUpdateMode = "push") => {
        const prefersMobileCard = window.matchMedia("(max-width: 900px)").matches;
        const candidates = Array.from(streamerCards);
        const preferredCard = candidates.find(
          (candidate) =>
            candidate.getAttribute("data-streamer-id") === streamerId &&
            candidate.classList.contains(prefersMobileCard ? "mobile-tile" : "tile"),
        );
        const fallbackCard = candidates.find(
          (candidate) => candidate.getAttribute("data-streamer-id") === streamerId,
        );

        const card = preferredCard || fallbackCard;

        if (card) {
          selectStreamer(card, urlMode);
          return true;
        }

        return false;
      };

      const normalizeCreatorKey = (value: string) =>
        value
          .trim()
          .replace(/^@+/, "")
          .normalize("NFKD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/&/g, "and")
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "");

      const getCreatorKeyFromPath = () => {
        const segments = window.location.pathname.split("/").filter(Boolean);

        while (segments[segments.length - 1]?.toLowerCase() === "index.html") {
          segments.pop();
        }

        const pathKey = segments[segments.length - 1] || "";

        if (!pathKey) {
          return "";
        }

        try {
          return decodeURIComponent(pathKey.replace(/\+/g, " "));
        } catch {
          return pathKey;
        }
      };

      const getInitialCreatorKey = () => {
        const key = new URLSearchParams(window.location.search).get("c");

        return key || getCreatorKeyFromPath();
      };

      const selectStreamerByCreatorKey = (
        creatorKey: string,
        urlMode: UrlUpdateMode = "push",
      ) => {
        const normalizedCreatorKey = normalizeCreatorKey(creatorKey);

        if (!normalizedCreatorKey) {
          return false;
        }

        const prefersMobileCard = window.matchMedia("(max-width: 900px)").matches;
        const candidates = Array.from(streamerCards);
        const matchesCreatorKey = (candidate: HTMLElement) =>
          [
            candidate.getAttribute("data-streamer-key") || "",
            candidate.getAttribute("data-streamer-name") || "",
            candidate.getAttribute("data-streamer-id") || "",
          ].some((candidateKey) => normalizeCreatorKey(candidateKey) === normalizedCreatorKey);
        const preferredCard = candidates.find(
          (candidate) =>
            matchesCreatorKey(candidate) &&
            candidate.classList.contains(prefersMobileCard ? "mobile-tile" : "tile"),
        );
        const fallbackCard = candidates.find(matchesCreatorKey);
        const card = preferredCard || fallbackCard;

        if (card) {
          selectStreamer(card, urlMode);
          return true;
        }

        return false;
      };

      const clearHoverPreview = () => {
        window.clearTimeout(hoverPreviewClearTimeout);
        hoverPreviewClearTimeout = window.setTimeout(() => {
          hoverPreviewCard = undefined;
          document.documentElement.classList.remove("has-streamer-hover-preview");

          if (!hasSelection()) {
            setSelectedStreamerName("");
            setSelectedStreamerProfileLink();
            setSelectedStreamerProfileIcon("");
            setSelectedStreamerPortrait("");
          }
        }, portraitFadeMs);
      };

      const previewStreamer = (card: HTMLElement) => {
        window.clearTimeout(hoverPreviewClearTimeout);
        if (hasSelection()) {
          return;
        }

        const streamerName = card.getAttribute("data-streamer-name") || "Streamer";
        const streamerImageTarget = getStreamerImageFromCard(card, activeStreamerImageMode);
        const streamerProfileUrl = card.getAttribute("data-streamer-profile-link-url") || "";
        const streamerProfilePlatform =
          card.getAttribute("data-streamer-profile-link-platform") || "";
        const streamerProfileIcon = card.getAttribute("data-streamer-profile-icon") || "";
        hoverPreviewCard = card;
        document.documentElement.classList.add("has-streamer-hover-preview");
        setSelectedStreamerName(streamerName);
        setSelectedStreamerProfileLink(
          streamerName,
          streamerProfileUrl,
          streamerProfilePlatform,
        );
        setSelectedStreamerProfileIcon(streamerProfileIcon);
        setSelectedStreamerPortrait(
          streamerImageTarget.image,
          streamerImageTarget.fallbackImage,
          streamerImageTarget.isGeneratedVariant,
        );
      };

      const resetReadyOverlayToEntrance = () => {
        document.documentElement.classList.add("ready-overlay-reset");
        document.documentElement.classList.remove("ready-overlay-exiting");
        document.querySelectorAll(".ready-panel").forEach((panel) => {
          panel.getBoundingClientRect();
        });
        window.requestAnimationFrame(() => {
          document.documentElement.classList.remove("ready-overlay-reset");
        });
      };

      const cancelReadyOverlayExit = () => {
        if (readyOverlayExitTimer) {
          window.clearTimeout(readyOverlayExitTimer);
          readyOverlayExitTimer = undefined;
        }

        if (document.documentElement.classList.contains("ready-overlay-exiting")) {
          resetReadyOverlayToEntrance();
        }
      };

      const showReadyOverlay = () => {
        cancelReadyOverlayExit();
        document.documentElement.classList.add("has-streamer-selected");
      };

      const hideReadyOverlay = () => {
        document.documentElement.classList.remove("has-streamer-selected");
        document.documentElement.classList.add("ready-overlay-exiting");

