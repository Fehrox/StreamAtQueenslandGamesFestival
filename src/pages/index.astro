        confirmWithTwitchButton?.textContent?.trim() || "Confirm with Twitch Account";
      const confirmWithoutVerifyingButton = document.querySelector<HTMLButtonElement>(
        "[data-confirm-without-verifying]",
      );
      const verificationResultModal = document.querySelector<HTMLDialogElement>(
        "[data-verification-result-modal]",
