---
import { streamers } from "@data/streamers";

const rosterColumns = 13;
const confirmationQuestions = [
  {
    id: "streaming-station",
    name: "streamingStation",
    label: "Want to stream indie games at a Stream Station?",
  },
  {
    id: "twitch-connect",
    name: "twitchConnect",
    label: "Will you be attending Twitch Connect?",
  },
  {
    id: "panel-interest",
    name: "panelInterest",
    label: "Are you interested in participating in a panel?",
  },
  {
    id: "travel-funding",
    name: "travelFunding",
    label: "Would you like to apply for Travel Funding?",
  },
  {
    id: "twitch-connect",
    name: "twitchConnect",
    label: "Will you be attending Twitch Connect?",
  },
  {
    id: "irl-streaming",
    name: "irlStreaming",
    label: "Will you be IRL streaming the event?",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Queensland Games Festival streamer invite screen."
    />
    <title>Queensland Games Festival Streamer Invite</title>
  </head>
  <body>
    <main class="viewport" aria-label="Queensland Games Festival streamer signup">
      <section class="stage" aria-label="Streamer selection screen">
        <header class="top-bar">
          <div class="nav-plate">
            <button
              type="button"
              class="back-action"
              data-back-arrow
              aria-label="Back to Queensland Games Festival"
            >
              <span class="back-icon" aria-hidden="true"></span>
            </button>
            <span class="book-icon" aria-hidden="true"></span>
          </div>
          <div class="title-tab">
            <span class="title-crop title-crop-left"></span>
            <h1>QGF Streamer Invite</h1>
            <span class="title-caret"></span>
          </div>
        </header>

        <section
          class="roster"
          style={`--roster-columns: ${rosterColumns}`}
          aria-label="Streamer roster placeholders"
        >
          {
            streamers.map((streamer, index) => (
              <article
                class={`tile tile-${streamer.status}`}
                style={`--tile-index: ${index}`}
                data-streamer-card
                data-streamer-id={streamer.id}
                data-streamer-name={streamer.name}
                role="button"
                tabindex="0"
                aria-pressed="false"
                aria-label={`${streamer.name} streamer slot`}
              >
                <div class="portrait" aria-hidden="true">
                  <span class="portrait-shape portrait-shape-a" />
                  <span class="portrait-shape portrait-shape-b" />
                  <span class="portrait-head" />
                  <span class="portrait-body" />
                </div>
                <div class="tile-shine" aria-hidden="true" />
                <h2>{streamer.name}</h2>
                <img
                  class="selection-marker"
                  src="/cursors/P1Marker.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </article>
            ))
          }
        </section>

        <section class="ready-overlay" aria-hidden="true">
          <div class="ready-panel">
            <span class="ready-rail ready-rail-top"></span>
            <div class="ready-banner">
              <span class="ready-red-wedge"></span>
              <span class="ready-yellow-wedge"></span>
              <p class="ready-copy">
                <span data-ready-word="READY">READY</span>
                <small data-ready-word="to">to</small>
                <span data-ready-word="STREAM!">STREAM!</span>
              </p>
            </div>
            <span class="ready-rail ready-rail-bottom"></span>
          </div>
        </section>

        <section class="bottom-dock" aria-label="Signup panel">
          <canvas
            class="dock-shader"
            data-dock-shader
            aria-hidden="true"
          ></canvas>
          <article class="player-panel player-panel-primary">
            <div class="panel-slash"></div>
            <div class="panel-portrait" aria-hidden="true">
              <span class="big-avatar-head"></span>
              <span class="big-avatar-body"></span>
              <span class="big-avatar-arm"></span>
            </div>
            <div class="player-red-card">
              <div class="watermark">QGF</div>
              <h2 data-selected-name></h2>
              <div class="player-info">
                <span>Streamer</span>
                <strong>0%</strong>
              </div>
              <div class="controller-strip">
                <span class="signal-bars" aria-hidden="true">
                  <i></i><i></i><i></i><i></i>
                </span>
                <span class="controller-icon" aria-hidden="true"></span>
                <strong>P1</strong>
              </div>
            </div>
          </article>

          <article class="player-panel player-panel-random" data-confirm-panel>
            <div class="question-mark" aria-hidden="true">?</div>
            <div class="random-copy">
              <h2>Confirm Attendance</h2>
              <button
                type="button"
                class="twitch-confirm-button"
                data-twitch-confirm
                hidden
                aria-label="Confirm selected creator with Twitch"
              >
                <span class="twitch-wordmark" aria-hidden="true">
                  <img
                    class="twitch-icon"
                    src="/icons/TwitchGlitchWhite.svg"
                    alt=""
                    draggable="false"
                  />
                  <span>Twitch</span>
                </span>
                <span class="twitch-confirm-label">Confirm with Twitch</span>
              </button>
            </div>
            <aside class="side-buttons" aria-hidden="true">
              <span>+1</span>
              <span></span>
            </aside>
          </article>
        </section>
      </section>

      <section class="mobile-layout" aria-label="Mobile streamer signup">
        <header class="mobile-top-bar">
          <div class="mobile-nav-plate">
            <button
              type="button"
              class="mobile-back-action"
              data-back-arrow
              aria-label="Back to Queensland Games Festival"
            >
              <span class="mobile-back-icon" aria-hidden="true"></span>
            </button>
            <span class="mobile-book-icon" aria-hidden="true"></span>
          </div>
          <div class="mobile-title-tab">
            <h1>QGF Streamer Invite</h1>
            <span class="mobile-title-caret"></span>
          </div>
        </header>

        <section class="mobile-roster" aria-label="Streamer roster placeholders">
          {
            streamers.map((streamer, index) => (
              <button
                type="button"
                class={`mobile-tile mobile-tile-${streamer.status}`}
                style={`--tile-index: ${index}`}
                data-mobile-streamer-card
                data-streamer-id={streamer.id}
                data-streamer-name={streamer.name}
                aria-pressed="false"
              >
                <span class="mobile-portrait" aria-hidden="true">
                  {
                    streamer.image ? (
                      <img src={streamer.image} alt="" loading="lazy" />
                    ) : (
                      <>
                        <span class="mobile-portrait-shape mobile-portrait-shape-a" />
                        <span class="mobile-portrait-shape mobile-portrait-shape-b" />
                        <span class="mobile-portrait-head" />
                        <span class="mobile-portrait-body" />
                      </>
                    )
                  }
                </span>
                <span class="mobile-tile-shine" aria-hidden="true"></span>
                <span class="mobile-tile-name">{streamer.name}</span>
                <img
                  class="selection-marker"
                  src="/cursors/P1Marker.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </button>
            ))
          }
        </section>

        <section class="mobile-cta" data-mobile-cta hidden aria-live="polite">
          <div class="mobile-cta-panel">
            <div class="mobile-cta-portrait" aria-hidden="true">
              <span class="mobile-big-avatar-head"></span>
              <span class="mobile-big-avatar-body"></span>
              <span class="mobile-big-avatar-arm"></span>
            </div>
            <div class="mobile-cta-card">
              <div class="mobile-watermark">QGF</div>
              <h2 data-mobile-selected-name></h2>
              <div class="mobile-player-info">
                <span>Streamer</span>
                <strong>0%</strong>
              </div>
              <button
                type="button"
                class="mobile-twitch-button"
                data-confirm-open
                aria-disabled="true"
              >
                <img
                  class="mobile-twitch-icon"
                  src="/icons/TwitchGlitchWhite.svg"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
                <span>Confirm with Twitch</span>
              </button>
            </div>
          </div>
        </section>
      </section>
    </main>

    <dialog
      class="confirm-modal"
      data-confirm-modal
      aria-labelledby="confirm-modal-title"
    >
      <form class="confirm-modal-frame" data-confirm-form method="dialog">
        <header class="confirm-modal-header">
          <div class="confirm-modal-brand" aria-hidden="true">
            <img
              src="/icons/TwitchGlitchWhite.svg"
              alt=""
              draggable="false"
            />
            <span>Twitch</span>
          </div>
          <h2 id="confirm-modal-title">Creator Confirmation</h2>
          <button
            type="button"
            class="confirm-modal-close"
            data-confirm-modal-close
            aria-label="Close confirmation form"
          >
            X
          </button>
        </header>

        <div class="confirm-modal-body">
          <div class="confirm-modal-fields">
            <label class="confirm-field">
              <span>Selected Creator</span>
              <select
                name="creator"
                data-confirm-streamer-select
                aria-label="Selected creator"
              >
                {
                  streamers.map((streamer) => (
                    <option value={streamer.id}>{streamer.name}</option>
                  ))
                }
              </select>
            </label>

            <label class="confirm-field">
              <span>Email Instead <small>optional</small></span>
              <input
                type="email"
                name="creatorEmail"
                autocomplete="email"
                placeholder="creator@example.com"
              />
            </label>
          </div>

          <div class="confirm-question-list" aria-label="Confirmation questions">
            {
              confirmationQuestions.map((question) => (
                <div
                  class="confirm-question"
                  role="group"
                  aria-labelledby={`${question.id}-label`}
                >
                  <p class="confirm-question-label" id={`${question.id}-label`}>
                    {question.label}
                  </p>
                  <div class="confirm-answer-toggle">
                    <label>
                      <input
                        type="radio"
                        name={question.name}
                        value="yes"
                      />
                      <span>Yes</span>
                    </label>
                    <label>
                      <input
                        type="radio"
                        name={question.name}
                        value="no"
                      />
                      <span>No</span>
                    </label>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <footer class="confirm-modal-footer">
          <button
            type="button"
            class="confirm-secondary-action"
            data-confirm-modal-close
          >
            Cancel
          </button>
          <button type="submit" class="confirm-primary-action">
            Save Details
          </button>
        </footer>
      </form>

      <div
        class="custom-cursor custom-cursor-modal"
        data-custom-cursor
        aria-hidden="true"
        hidden
      >
        <div class="custom-cursor-art">
          <img
            class="custom-cursor-hand custom-cursor-hand-marker"
            src="/cursors/MarkerHand.png"
            alt=""
            draggable="false"
          />
          <img
            class="custom-cursor-hand custom-cursor-hand-pointer"
            src="/cursors/PointerHand.png"
            alt=""
            draggable="false"
          />
          <img
            class="custom-cursor-hand custom-cursor-hand-open"
            src="/cursors/OpenHand.png"
            alt=""
            draggable="false"
          />
          <img
            class="custom-cursor-p1"
            src="/cursors/P1.png"
            alt=""
            draggable="false"
          />
        </div>
      </div>
    </dialog>

    <div class="custom-cursor" data-custom-cursor aria-hidden="true" hidden>
      <div class="custom-cursor-art">
        <img
          class="custom-cursor-hand custom-cursor-hand-marker"
          src="/cursors/MarkerHand.png"
          alt=""
          draggable="false"
        />
        <img
          class="custom-cursor-hand custom-cursor-hand-pointer"
          src="/cursors/PointerHand.png"
          alt=""
          draggable="false"
        />
        <img
          class="custom-cursor-hand custom-cursor-hand-open"
          src="/cursors/OpenHand.png"
          alt=""
          draggable="false"
        />
        <img
          class="custom-cursor-p1"
          src="/cursors/P1.png"
          alt=""
          draggable="false"
        />
      </div>
    </div>

    <script>
      const setStageScale = () => {
        const scale = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
        document.documentElement.style.setProperty("--stage-scale", String(scale));
      };

      setStageScale();
      window.addEventListener("resize", setStageScale, { passive: true });

      const streamerCards = document.querySelectorAll<HTMLElement>(
        "[data-streamer-card], [data-mobile-streamer-card]",
      );
      const backArrows = document.querySelectorAll<HTMLElement>("[data-back-arrow]");
      const mobileCta = document.querySelector("[data-mobile-cta]");
      const selectedName = document.querySelector("[data-selected-name]");
      const mobileSelectedName = document.querySelector("[data-mobile-selected-name]");
      const twitchConfirmButtons = document.querySelectorAll<HTMLButtonElement>(
        "[data-twitch-confirm]",
      );
      const confirmPanel = document.querySelector<HTMLElement>("[data-confirm-panel]");
      const confirmOpenButtons = document.querySelectorAll<HTMLButtonElement>("[data-confirm-open]");
      const confirmModal = document.querySelector<HTMLDialogElement>("[data-confirm-modal]");
      const confirmModalCloseButtons = document.querySelectorAll<HTMLButtonElement>(
        "[data-confirm-modal-close]",
      );
      const confirmStreamerSelect = document.querySelector<HTMLSelectElement>(
        "[data-confirm-streamer-select]",
      );
      const festivalUrl = "https://www.queenslandgamesfestival.com/";
      const readyOverlayExitMs = 280;
      let readyOverlayExitTimer: number | undefined;
      let selectedStreamerId: string | undefined;

      const hasSelection = () =>
        document.documentElement.classList.contains("has-streamer-selected");

      const isConfirmModalOpen = () => confirmModal instanceof HTMLDialogElement && confirmModal.open;

      const setSelectedStreamerName = (streamerName: string) => {
        if (selectedName instanceof HTMLElement) {
          selectedName.textContent = streamerName;
        }

        if (mobileSelectedName instanceof HTMLElement) {
          mobileSelectedName.textContent = streamerName;
        }
      };

      const setCursorOverStreamerCard = (isOver: boolean) => {
        document.documentElement.classList.toggle("custom-cursor-over-streamer-card", isOver);
      };

      const setTwitchConfirmButtonVisibility = (streamerName = "") => {
        const hasStreamerName = streamerName.length > 0;

        twitchConfirmButtons.forEach((button) => {
          button.hidden = !hasStreamerName;
          button.setAttribute("aria-disabled", String(!hasStreamerName));
          button.setAttribute(
            "aria-label",
            hasStreamerName
              ? `Confirm ${streamerName} with Twitch`
              : "Confirm selected creator with Twitch",
          );
        });
      };

      const syncConfirmStreamerSelect = () => {
        if (confirmStreamerSelect instanceof HTMLSelectElement && selectedStreamerId) {
          confirmStreamerSelect.value = selectedStreamerId;
        }
      };

      const openConfirmModal = () => {
        if (!hasSelection() || !(confirmModal instanceof HTMLDialogElement)) {
          return;
        }

        syncConfirmStreamerSelect();
        document.documentElement.classList.add("has-confirm-modal-open");

        if (!confirmModal.open) {
          confirmModal.showModal();
        }
      };

      const closeConfirmModal = () => {
        if (confirmModal instanceof HTMLDialogElement && confirmModal.open) {
          confirmModal.close();
        }
      };

      const selectStreamerById = (streamerId: string) => {
        const prefersMobileCard = window.matchMedia("(max-width: 900px)").matches;
        const candidates = Array.from(streamerCards);
        const preferredCard = candidates.find(
          (candidate) =>
            candidate.getAttribute("data-streamer-id") === streamerId &&
            candidate.classList.contains(prefersMobileCard ? "mobile-tile" : "tile"),
        );
        const fallbackCard = candidates.find(
          (candidate) => candidate.getAttribute("data-streamer-id") === streamerId,
        );
        const card = preferredCard || fallbackCard;

        if (card) {
          selectStreamer(card);
        }
      };

      const clearHoverPreview = () => {
        document.documentElement.classList.remove("has-streamer-hover-preview");

        if (!hasSelection()) {
          setSelectedStreamerName("");
        }
      };

      const previewStreamer = (card: HTMLElement) => {
        if (hasSelection()) {
          return;
        }

        const streamerName = card.getAttribute("data-streamer-name") || "Streamer";
        document.documentElement.classList.add("has-streamer-hover-preview");
        setSelectedStreamerName(streamerName);
      };

      const resetReadyOverlayToEntrance = () => {
        document.documentElement.classList.add("ready-overlay-reset");
        document.documentElement.classList.remove("ready-overlay-exiting");
        document.querySelector(".ready-panel")?.getBoundingClientRect();
        window.requestAnimationFrame(() => {
          document.documentElement.classList.remove("ready-overlay-reset");
        });
      };

      const cancelReadyOverlayExit = () => {
        if (readyOverlayExitTimer) {
          window.clearTimeout(readyOverlayExitTimer);
          readyOverlayExitTimer = undefined;
        }

        if (document.documentElement.classList.contains("ready-overlay-exiting")) {
          resetReadyOverlayToEntrance();
        }
      };

      const showReadyOverlay = () => {
        cancelReadyOverlayExit();
        document.documentElement.classList.add("has-streamer-selected");
      };

      const hideReadyOverlay = () => {
        document.documentElement.classList.remove("has-streamer-selected");
        document.documentElement.classList.add("ready-overlay-exiting");

        if (readyOverlayExitTimer) {
          window.clearTimeout(readyOverlayExitTimer);
        }

        readyOverlayExitTimer = window.setTimeout(() => {
          resetReadyOverlayToEntrance();
          readyOverlayExitTimer = undefined;
        }, readyOverlayExitMs);
      };

      const clearSelection = () => {
        closeConfirmModal();
        hideReadyOverlay();
        document.documentElement.classList.remove("has-streamer-hover-preview");
        selectedStreamerId = undefined;

        streamerCards.forEach((candidate) => {
          candidate.classList.remove("tile-selected", "mobile-tile-selected");
          candidate.setAttribute("aria-pressed", "false");
        });

        setSelectedStreamerName("");
        setTwitchConfirmButtonVisibility();

        if (mobileCta instanceof HTMLElement) {
          mobileCta.hidden = true;
        }
      };

      const selectStreamer = (card: HTMLElement) => {
        const streamerId = card.getAttribute("data-streamer-id");
        const streamerName = card.getAttribute("data-streamer-name") || "Streamer";

        showReadyOverlay();
        document.documentElement.classList.remove("has-streamer-hover-preview");
        selectedStreamerId = streamerId || undefined;

        streamerCards.forEach((candidate) => {
          const isSelected = streamerId
            ? candidate.getAttribute("data-streamer-id") === streamerId
            : candidate === card;
          candidate.classList.toggle(
            "tile-selected",
            isSelected && candidate.classList.contains("tile"),
          );
          candidate.classList.toggle(
            "mobile-tile-selected",
            isSelected && candidate.classList.contains("mobile-tile"),
          );
          candidate.setAttribute("aria-pressed", String(isSelected));
        });

        setSelectedStreamerName(streamerName);
        setTwitchConfirmButtonVisibility(streamerName);
        syncConfirmStreamerSelect();

        if (mobileCta instanceof HTMLElement && card.classList.contains("mobile-tile")) {
          const wasHidden = mobileCta.hidden;
          mobileCta.hidden = false;

          if (wasHidden && window.matchMedia("(max-width: 900px)").matches) {
            mobileCta.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        }
      };

      confirmPanel?.addEventListener("click", () => {
        openConfirmModal();
      });

      confirmOpenButtons.forEach((button) => {
        button.addEventListener("click", (event) => {
          event.preventDefault();
          openConfirmModal();
        });
      });

      confirmModalCloseButtons.forEach((button) => {
        button.addEventListener("click", () => {
          closeConfirmModal();
        });
      });

      confirmModal?.addEventListener("click", (event) => {
        if (event.target === confirmModal) {
          closeConfirmModal();
        }
      });

      confirmModal?.addEventListener("close", () => {
        document.documentElement.classList.remove("has-confirm-modal-open");
      });

      confirmStreamerSelect?.addEventListener("change", () => {
        selectStreamerById(confirmStreamerSelect.value);
      });

      const activateStreamer = (card: HTMLElement) => {
        if (hasSelection()) {
          clearSelection();
          return;
        }

        selectStreamer(card);
      };

      streamerCards.forEach((card) => {
        card.addEventListener("mouseenter", () => {
          setCursorOverStreamerCard(true);
          previewStreamer(card);
        });

        card.addEventListener("mouseleave", () => {
          setCursorOverStreamerCard(false);
          clearHoverPreview();
        });

        card.addEventListener("click", () => {
          activateStreamer(card);
        });

        card.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") {
            return;
          }

          event.preventDefault();
          activateStreamer(card);
        });
      });

      backArrows.forEach((backArrow) => {
        backArrow.addEventListener("click", () => {
          window.location.href = festivalUrl;
        });
      });

      window.addEventListener("contextmenu", (event) => {
        if (isConfirmModalOpen()) {
          return;
        }

        if (!hasSelection()) {
          return;
        }

        event.preventDefault();
        clearSelection();
      });

      window.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && isConfirmModalOpen()) {
          return;
        }

        if (event.key !== "Escape" || !hasSelection()) {
          return;
        }

        event.preventDefault();
        clearSelection();
      });

      const customCursors = document.querySelectorAll<HTMLElement>("[data-custom-cursor]");
      const customCursorQuery = window.matchMedia("(hover: hover) and (pointer: fine)");
      let cursorFrame = 0;
      let cursorX = -200;
      let cursorY = -200;

      const syncCustomCursor = () => {
        const isEnabled = customCursorQuery.matches && customCursors.length > 0;
        document.documentElement.classList.toggle("custom-cursor-enabled", isEnabled);

        if (!isEnabled) {
          setCursorOverStreamerCard(false);
        }

        customCursors.forEach((customCursor) => {
          customCursor.hidden = !isEnabled;
          customCursor.classList.toggle("custom-cursor-visible", false);
        });
      };

      const positionCustomCursor = () => {
        customCursors.forEach((customCursor) => {
          customCursor.style.transform = `translate3d(${cursorX}px, ${cursorY}px, 0)`;
        });

        cursorFrame = 0;
      };

      syncCustomCursor();
      customCursorQuery.addEventListener("change", syncCustomCursor);

      window.addEventListener(
        "pointermove",
        (event) => {
          if (
            event.pointerType !== "mouse" ||
            !customCursorQuery.matches ||
            customCursors.length === 0
          ) {
            return;
          }

          cursorX = event.clientX;
          cursorY = event.clientY;
          customCursors.forEach((customCursor) => {
            customCursor.classList.add("custom-cursor-visible");
          });

          if (!cursorFrame) {
            cursorFrame = window.requestAnimationFrame(positionCustomCursor);
          }
        },
        { passive: true },
      );

      window.addEventListener("pointerout", (event) => {
        if (!event.relatedTarget && customCursors.length > 0) {
          customCursors.forEach((customCursor) => {
            customCursor.classList.remove("custom-cursor-visible");
          });
          setCursorOverStreamerCard(false);
        }
      });

      window.addEventListener("blur", () => {
        if (customCursors.length > 0) {
          customCursors.forEach((customCursor) => {
            customCursor.classList.remove("custom-cursor-visible");
            customCursor.classList.remove("custom-cursor-pressed");
          });
          setCursorOverStreamerCard(false);
        }
      });

      window.addEventListener("pointerdown", (event) => {
        if (event.pointerType === "mouse" && customCursors.length > 0) {
          customCursors.forEach((customCursor) => {
            customCursor.classList.add("custom-cursor-pressed");
          });
        }
      });

      window.addEventListener("pointerup", (event) => {
        if (event.pointerType === "mouse" && customCursors.length > 0) {
          customCursors.forEach((customCursor) => {
            customCursor.classList.remove("custom-cursor-pressed");
          });
        }
      });

      const createRosterShader = () => {
        const desktopRoster = document.querySelector(".roster");
        const mobileRoster = document.querySelector(".mobile-roster");

        if (!(desktopRoster instanceof HTMLElement) || !(mobileRoster instanceof HTMLElement)) {
          return;
        }

        const canvas = document.createElement("canvas");
        canvas.className = "roster-shader";
        canvas.setAttribute("aria-hidden", "true");

        const gl = canvas.getContext("webgl", {
          alpha: false,
          antialias: false,
          depth: false,
          stencil: false,
        });

        if (!gl) {
          return;
        }

        const vertexSource = `
          attribute vec2 aPosition;

          void main() {
            gl_Position = vec4(aPosition, 0.0, 1.0);
          }
        `;

        const fragmentSource = `
          precision highp float;

          uniform vec3 iResolution;
          uniform float iTime;

          #define SPEED 2.0

          float hash11(float n)
          {
              return fract(sin(n) * 43758.5453123);
          }

          float hash21(vec2 p)
          {
              p = fract(p * vec2(123.34, 456.21));
              p += dot(p, p + 45.32);
              return fract(p.x * p.y);
          }

          vec2 hash22(vec2 p)
          {
              float n = hash21(p);
              return vec2(n, hash21(p + n + 19.19));
          }

          float noise(vec2 p)
          {
              vec2 i = floor(p);
              vec2 f = fract(p);

              vec2 u = f * f * (3.0 - 2.0 * f);

              float a = hash21(i);
              float b = hash21(i + vec2(1.0, 0.0));
              float c = hash21(i + vec2(0.0, 1.0));
              float d = hash21(i + vec2(1.0, 1.0));

              return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
          }

          float fbm(vec2 p)
          {
              float v = 0.0;
              float a = 0.5;

              mat2 m = mat2(
                   1.6,  1.2,
                  -1.2,  1.6
              );

              for (int i = 0; i < 6; i++)
              {
                  v += a * noise(p);
                  p = m * p + 7.13;
                  a *= 0.5;
              }

              return v;
          }

          float softBlob(vec2 uv, vec2 center, vec2 scale, float softness)
          {
              vec2 p = (uv - center) / scale;
              float d = dot(p, p);
              return exp(-d * softness);
          }

          float twinkleSpeckles(vec2 uv, float density, float threshold, float sizeMin, float sizeMax, float t)
          {
              vec2 g = uv * density;
              vec2 id = floor(g);
              vec2 f = fract(g) - 0.5;

              vec2 rnd = hash22(id) - 0.5;
              float seed = hash21(id + 31.7);

              float d = length(f - rnd * 0.75);
              float radius = mix(sizeMin, sizeMax, hash21(id + 9.2));

              float dotShape = 1.0 - smoothstep(radius, radius * 1.8, d);

              float phase = hash21(id + 100.0) * 6.28318;
              float speed = mix(0.6, 2.4, hash21(id + 200.0));
              float pulse = 0.5 + 0.5 * sin(t * speed + phase);

              float visible = step(threshold, seed);
              return dotShape * pulse * visible;
          }

          vec3 palette(vec2 uv)
          {
              vec3 coral    = vec3(1.00, 0.36, 0.47);
              vec3 peach    = vec3(1.00, 0.71, 0.55);
              vec3 pink     = vec3(1.00, 0.28, 0.73);
              vec3 rose     = vec3(0.97, 0.42, 0.86);
              vec3 lavender = vec3(0.72, 0.54, 1.00);
              vec3 violet   = vec3(0.42, 0.18, 0.98);
              vec3 deepVio  = vec3(0.28, 0.10, 0.78);

              float leftToRight = smoothstep(-0.15, 1.15, uv.x);

              vec3 col = mix(coral, violet, leftToRight);
              col = mix(col, pink, 0.38);
              col = mix(col, lavender, smoothstep(0.25, 0.95, uv.x) * 0.34);
              col = mix(col, deepVio, smoothstep(0.62, 1.08, uv.x + (1.0 - uv.y) * 0.42) * 0.36);
              col = mix(col, peach, softBlob(uv, vec2(0.23, 0.68), vec2(0.32, 0.28), 1.8) * 0.58);
              col = mix(col, rose,  softBlob(uv, vec2(0.55, 0.58), vec2(0.48, 0.32), 2.0) * 0.36);

              return col;
          }

          void mainImage(out vec4 fragColor, in vec2 fragCoord)
          {
              vec2 uv = fragCoord.xy / iResolution.xy;
              float aspect = iResolution.x / iResolution.y;
              vec2 q = vec2((uv.x - 0.5) * aspect, uv.y - 0.5);

              float t = iTime * 0.18 * SPEED;

              vec2 baseDrift = vec2(t * 0.11, -t * 0.035);

              vec2 warpA = vec2(
                  fbm(uv * 2.2 + baseDrift + vec2(0.0, 0.0)),
                  fbm(uv * 2.2 + baseDrift + vec2(8.4, 3.1))
              );

              vec2 warpB = vec2(
                  fbm(uv * 5.6 + warpA * 2.4 + vec2(1.3 * t, -0.7 * t)),
                  fbm(uv * 5.6 + warpA * 2.4 + vec2(-0.9 * t, 0.8 * t))
              );

              vec2 wuv = uv;
              wuv += (warpA - 0.5) * 0.18;
              wuv += (warpB - 0.5) * 0.08;

              wuv.x += 0.012 * sin(wuv.y * 8.0 + t * 1.2);
              wuv.y += 0.010 * sin(wuv.x * 7.0 - t * 1.0);

              float clouds1 = fbm(wuv * vec2(3.0 * aspect, 3.0) + vec2(1.3, 0.5) + vec2(0.25 * t, -0.10 * t));
              float clouds2 = fbm(wuv * vec2(7.0 * aspect, 7.0) + vec2(8.0, 2.0) + vec2(-0.18 * t, 0.12 * t));
              float clouds3 = fbm(wuv * vec2(13.0 * aspect, 13.0) + vec2(4.0, 9.0) + vec2(0.10 * t, 0.16 * t));

              vec2 colorUv = uv;
              colorUv += (warpA - 0.5) * 0.10;
              colorUv += (warpB - 0.5) * 0.045;
              colorUv.x += 0.060 * sin(t * 0.58 + uv.y * 4.2)
                         + 0.030 * sin(t * 0.34 + uv.x * 5.5 + uv.y * 2.0);
              colorUv.y += 0.050 * cos(t * 0.46 + uv.x * 3.6)
                         + 0.024 * sin(t * 0.40 + uv.y * 5.2);

              vec3 col = mix(palette(uv), palette(colorUv), 0.62);

              float warmMist = smoothstep(0.42, 0.92, clouds1)
                             * softBlob(uv, vec2(0.24, 0.70), vec2(0.54, 0.40), 1.4);

              float pinkMist = smoothstep(0.28, 0.82, clouds2)
                             * softBlob(uv, vec2(0.42, 0.45), vec2(0.75, 0.55), 1.2);

              float violetMist = smoothstep(0.34, 0.90, clouds1 + clouds2 * 0.35)
                               * smoothstep(0.25, 1.05, uv.x + (1.0 - uv.y) * 0.55);

              vec3 cream   = vec3(1.00, 0.88, 0.72);
              vec3 hotPink = vec3(1.00, 0.20, 0.78);
              vec3 magenta = vec3(0.88, 0.22, 0.96);
              vec3 blueVio = vec3(0.38, 0.22, 1.00);

              col = mix(col, cream,   warmMist * 0.42);
              col = mix(col, hotPink, pinkMist * 0.22);
              col = mix(col, magenta, smoothstep(0.45, 0.85, clouds2) * 0.23);
              col = mix(col, blueVio, violetMist * 0.34);

              float mottled = clouds2 * 0.55 + clouds3 * 0.45;
              col += (mottled - 0.5) * 0.16;

              float paleSplash =
                  smoothstep(0.60, 0.93, fbm(wuv * vec2(9.0 * aspect, 9.0) + 10.0 + vec2(-0.20 * t, 0.18 * t))) *
                  smoothstep(0.20, 0.95, fbm(wuv * vec2(2.0 * aspect, 2.0) - 5.0 + vec2(0.08 * t, -0.10 * t)));

              col = mix(col, vec3(1.0, 0.82, 0.95), paleSplash * 0.23);

              float glowPulse1 = 0.5 + 0.5 * sin(t * 0.9);
              float glowPulse2 = 0.5 + 0.5 * sin(t * 1.2 + 1.7);
              float glowPulse3 = 0.5 + 0.5 * sin(t * 0.7 + 3.1);

              float glow1 = softBlob(uv, vec2(0.23, 0.82), vec2(0.24, 0.22), 2.2) * (0.75 + 0.25 * glowPulse1);
              float glow2 = softBlob(uv, vec2(0.35, 0.57), vec2(0.36, 0.24), 2.6) * (0.75 + 0.25 * glowPulse2);
              float glow3 = softBlob(uv, vec2(0.68, 0.58), vec2(0.38, 0.32), 2.0) * (0.75 + 0.25 * glowPulse3);
              float glow4 = softBlob(uv, vec2(0.86, 0.70), vec2(0.28, 0.25), 2.4) * (0.80 + 0.20 * glowPulse1);

              col = mix(col, vec3(1.00, 0.82, 0.68), glow1 * 0.26);
              col = mix(col, vec3(1.00, 0.70, 0.78), glow2 * 0.20);
              col = mix(col, vec3(0.95, 0.62, 1.00), glow3 * 0.25);
              col = mix(col, vec3(0.80, 0.55, 1.00), glow4 * 0.18);

              float s1 = twinkleSpeckles(uv + (warpA - 0.5) * 0.02, 115.0, 0.935, 0.035, 0.095, t * 2.0);
              float s2 = twinkleSpeckles(uv + (warpB - 0.5) * 0.01, 210.0, 0.970, 0.020, 0.060, t * 2.7);
              float s3 = twinkleSpeckles(uv,                          420.0, 0.992, 0.010, 0.032, t * 3.2);

              float speck = s1 * 0.55 + s2 * 0.45 + s3 * 0.35;
              col = mix(col, vec3(1.0), clamp(speck, 0.0, 1.0) * 0.55);

              float grain = hash21(fragCoord.xy + floor(iTime * 24.0));
              col += (grain - 0.5) * 0.028;

              float edge = length(q * vec2(0.33, 0.72));
              col *= 1.04 - smoothstep(0.28, 0.78, edge) * 0.09;

              col = clamp(col, 0.0, 1.0);
              col = pow(col, vec3(0.92));
              col = mix(vec3(dot(col, vec3(0.299, 0.587, 0.114))), col, 1.14);

              fragColor = vec4(col, 1.0);
          }

          void main() {
            mainImage(gl_FragColor, gl_FragCoord.xy);
          }
        `;

        const compileShader = (type: number, source: string) => {
          const shader = gl.createShader(type);

          if (!shader) {
            return null;
          }

          gl.shaderSource(shader, source);
          gl.compileShader(shader);

          if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            console.warn("Roster shader compile failed:", gl.getShaderInfoLog(shader));
            gl.deleteShader(shader);
            return null;
          }

          return shader;
        };

        const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
        const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);

        if (!vertexShader || !fragmentShader) {
          return;
        }

        const program = gl.createProgram();

        if (!program) {
          return;
        }

        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);
        gl.deleteShader(vertexShader);
        gl.deleteShader(fragmentShader);

        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          console.warn("Roster shader link failed:", gl.getProgramInfoLog(program));
          gl.deleteProgram(program);
          return;
        }

        const positionLocation = gl.getAttribLocation(program, "aPosition");
        const resolutionLocation = gl.getUniformLocation(program, "iResolution");
        const timeLocation = gl.getUniformLocation(program, "iTime");
        const positionBuffer = gl.createBuffer();

        if (!positionBuffer || positionLocation < 0 || !resolutionLocation || !timeLocation) {
          gl.deleteProgram(program);
          return;
        }

        gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        gl.useProgram(program);
        gl.enableVertexAttribArray(positionLocation);
        gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0);

        const mobileMedia = window.matchMedia("(max-width: 900px)");
        let animationFrame = 0;
        let startTime = performance.now();
        let currentHost: HTMLElement | null = null;

        const getActiveHost = () => mobileMedia.matches ? mobileRoster : desktopRoster;

        const syncHost = () => {
          const activeHost = getActiveHost();

          if (currentHost !== activeHost) {
            currentHost?.classList.remove("shader-active");
            activeHost.prepend(canvas);
            activeHost.classList.add("shader-active", "shader-ready");
            currentHost = activeHost;
          }
        };

        const resizeCanvas = () => {
          const rect = canvas.getBoundingClientRect();
          const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
          const width = Math.max(1, Math.round(rect.width * pixelRatio));
          const height = Math.max(1, Math.round(rect.height * pixelRatio));

          if (canvas.width !== width || canvas.height !== height) {
            canvas.width = width;
            canvas.height = height;
          }

          gl.viewport(0, 0, width, height);
          gl.uniform3f(resolutionLocation, width, height, pixelRatio);
        };

        const render = (now: number) => {
          syncHost();
          resizeCanvas();
          gl.useProgram(program);
          gl.uniform1f(timeLocation, (now - startTime) / 1000);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          animationFrame = window.requestAnimationFrame(render);
        };

        const restartRenderLoop = () => {
          window.cancelAnimationFrame(animationFrame);
          startTime = performance.now();
          animationFrame = window.requestAnimationFrame(render);
        };

        desktopRoster.classList.add("shader-ready");
        mobileRoster.classList.add("shader-ready");
        syncHost();
        restartRenderLoop();

        window.addEventListener("resize", restartRenderLoop, { passive: true });
        mobileMedia.addEventListener("change", restartRenderLoop);
      };

      const createDockShader = () => {
        const canvas = document.querySelector("[data-dock-shader]");

        if (!(canvas instanceof HTMLCanvasElement)) {
          return;
        }

        const gl = canvas.getContext("webgl", {
          alpha: false,
          antialias: false,
          depth: false,
          stencil: false,
        });

        if (!gl) {
          return;
        }

        const vertexSource = `
          attribute vec2 aPosition;

          void main() {
            gl_Position = vec4(aPosition, 0.0, 1.0);
          }
        `;

        const fragmentSource = `
          precision highp float;

          uniform vec3 iResolution;
          uniform float iTime;

          #define S(a,b,t) smoothstep(a,b,t)

          mat2 Rot(float a)
          {
              float s = sin(a);
              float c = cos(a);
              return mat2(c, -s, s, c);
          }

          vec2 hash(vec2 p)
          {
              p = vec2(dot(p, vec2(2127.1, 81.17)),
                       dot(p, vec2(1269.5, 283.37)));
              return fract(sin(p) * 43758.5453);
          }

          float noise(in vec2 p)
          {
              vec2 i = floor(p);
              vec2 f = fract(p);

              vec2 u = f * f * (3.0 - 2.0 * f);

              float n = mix(
                  mix(dot(-1.0 + 2.0 * hash(i + vec2(0.0, 0.0)), f - vec2(0.0, 0.0)),
                      dot(-1.0 + 2.0 * hash(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0)), u.x),
                  mix(dot(-1.0 + 2.0 * hash(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0)),
                      dot(-1.0 + 2.0 * hash(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0)), u.x),
                  u.y
              );

              return 0.5 + 0.5 * n;
          }

          vec3 topGradient(float t)
          {
              vec3 A = vec3(67.0,  49.0, 171.0) / 255.0;
              vec3 B = vec3(18.0, 135.0, 255.0) / 255.0;
              vec3 C = vec3(125.0, 226.0, 251.0) / 255.0;
              vec3 D = vec3(244.0, 244.0, 223.0) / 255.0;

              t = clamp(t, 0.0, 1.0);

              if (t < 0.33) return mix(A, B, S(0.00, 0.33, t));
              if (t < 0.66) return mix(B, C, S(0.33, 0.66, t));
              return mix(C, D, S(0.66, 1.00, t));
          }

          vec3 sideGradient(float t)
          {
              vec3 A = vec3(26.0,  62.0,  75.0) / 255.0;
              vec3 B = vec3(62.0, 202.0, 240.0) / 255.0;
              vec3 C = vec3(42.0, 142.0, 227.0) / 255.0;
              vec3 D = vec3(92.0,  80.0, 206.0) / 255.0;
              vec3 E = vec3(131.0, 99.0, 175.0) / 255.0;

              t = clamp(t, 0.0, 1.0);

              if (t < 0.25) return mix(A, B, S(0.00, 0.25, t));
              if (t < 0.50) return mix(B, C, S(0.25, 0.50, t));
              if (t < 0.75) return mix(C, D, S(0.50, 0.75, t));
              return mix(D, E, S(0.75, 1.00, t));
          }

          void mainImage(out vec4 fragColor, in vec2 fragCoord)
          {
              vec2 uv = fragCoord / iResolution.xy;
              float ratio = iResolution.x / iResolution.y;
              float t = iTime;

              vec2 tuv = uv;
              tuv -= 0.5;

              float degree = noise(vec2(t * 0.10, tuv.x * tuv.y));

              tuv.y *= 1.0 / ratio;
              tuv *= Rot(radians((degree - 0.5) * 720.0 + 180.0));
              tuv.y *= ratio;

              float frequency = 5.0;
              float amplitude = 30.0;
              float speed = t * 2.0;

              tuv.x += sin(tuv.y * frequency + speed) / amplitude;
              tuv.y += sin(tuv.x * frequency * 1.5 + speed) / (amplitude * 0.5);

              vec2 guv = tuv;
              guv.x += 0.08 * sin(t * 0.50 + guv.y * 4.0);
              guv.y += 0.06 * cos(t * 0.40 + guv.x * 5.0);

              float gx = clamp((guv * Rot(radians(-5.0))).x + 0.5, 0.0, 1.0);
              float gy = clamp(guv.y + 0.5, 0.0, 1.0);

              vec3 layer1 = topGradient(gx);
              vec3 layer2 = sideGradient(1.0 - gy);

              float mixMask = 1.0 - S(-0.3, 0.5, tuv.y);
              vec3 finalComp = mix(layer1, layer2, mixMask);

              float glow = 0.08 * (1.0 - S(-0.2, 0.6, abs(tuv.y - 0.05)));
              finalComp += glow * vec3(0.08, 0.12, 0.18);

              float grain = fract(sin(dot(fragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
              finalComp += (grain - 0.5) * 0.015;

              fragColor = vec4(clamp(finalComp, 0.0, 1.0), 1.0);
          }

          void main() {
            mainImage(gl_FragColor, gl_FragCoord.xy);
          }
        `;

        const compileShader = (type: number, source: string): WebGLShader | null => {
          const shader = gl.createShader(type);

          if (!shader) {
            return null;
          }

          gl.shaderSource(shader, source);
          gl.compileShader(shader);

          if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
            console.warn("Dock shader compile failed:", gl.getShaderInfoLog(shader));
            gl.deleteShader(shader);
            return null;
          }

          return shader;
        };

        const vertexShader = compileShader(gl.VERTEX_SHADER, vertexSource);
        const fragmentShader = compileShader(gl.FRAGMENT_SHADER, fragmentSource);

        if (!vertexShader || !fragmentShader) {
          return;
        }

        const program = gl.createProgram();

        if (!program) {
          return;
        }

        gl.attachShader(program, vertexShader);
        gl.attachShader(program, fragmentShader);
        gl.linkProgram(program);
        gl.deleteShader(vertexShader);
        gl.deleteShader(fragmentShader);

        if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
          console.warn("Dock shader link failed:", gl.getProgramInfoLog(program));
          gl.deleteProgram(program);
          return;
        }

        const positionLocation = gl.getAttribLocation(program, "aPosition");
        const resolutionLocation = gl.getUniformLocation(program, "iResolution");
        const timeLocation = gl.getUniformLocation(program, "iTime");
        const positionBuffer = gl.createBuffer();

        if (!positionBuffer || positionLocation < 0 || !resolutionLocation || !timeLocation) {
          gl.deleteProgram(program);
          return;
        }

        gl.bindBuffer(gl.ARRAY_BUFFER, positionBuffer);
        gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
        gl.useProgram(program);
        gl.enableVertexAttribArray(positionLocation);
        gl.vertexAttribPointer(positionLocation, 2, gl.FLOAT, false, 0, 0);

        let animationFrame = 0;
        const startTime = performance.now();

        const resizeCanvas = () => {
          const rect = canvas.getBoundingClientRect();
          const pixelRatio = Math.min(window.devicePixelRatio || 1, 2);
          const width = Math.max(1, Math.round(rect.width * pixelRatio));
          const height = Math.max(1, Math.round(rect.height * pixelRatio));

          if (canvas.width !== width || canvas.height !== height) {
            canvas.width = width;
            canvas.height = height;
          }

          gl.viewport(0, 0, width, height);
          gl.uniform3f(resolutionLocation, width, height, pixelRatio);
        };

        const render = (now: number) => {
          resizeCanvas();
          gl.useProgram(program);
          gl.uniform1f(timeLocation, (now - startTime) / 1000);
          gl.drawArrays(gl.TRIANGLES, 0, 3);
          animationFrame = window.requestAnimationFrame(render);
        };

        canvas.parentElement?.classList.add("shader-ready");
        animationFrame = window.requestAnimationFrame(render);

        window.addEventListener("resize", () => {
          window.cancelAnimationFrame(animationFrame);
          animationFrame = window.requestAnimationFrame(render);
        }, { passive: true });
      };

      createRosterShader();
      createDockShader();
    </script>
  </body>
</html>

<style>
  @property --selected-border-color {
    syntax: "<color>";
    inherits: false;
    initial-value: #f62624;
  }

  @keyframes selected-border-pulse {
    0%,
    100% {
      --selected-border-color: #f62624;
    }

    38% {
      --selected-border-color: #fff;
    }
  }

  @keyframes twitch-cta-pulse {
    0%,
    100% {
      transform: scale(1) rotate(-1.2deg);
    }

    50% {
      transform: scale(1.045) rotate(1.2deg);
    }
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(html),
  :global(body) {
    margin: 0;
    min-width: 100%;
    min-height: 100%;
    background: #080d10;
    color: #fff;
    font-family:
      Impact,
      Haettenschweiler,
      "Arial Narrow Bold",
      "Arial Black",
      system-ui,
      sans-serif;
    overflow: hidden;
  }

  :global(body) {
    min-height: 100vh;
  }

  .confirm-modal {
    width: min(1020px, calc(100vw - 40px));
    max-height: calc(100svh - 40px);
    padding: 0;
    border: 0;
    background: transparent;
    color: #101416;
    overflow: visible;
  }

  .confirm-modal::backdrop {
    background:
      linear-gradient(127deg, rgba(145, 70, 255, 0.22), transparent 45%),
      rgba(3, 7, 10, 0.76);
  }

  .confirm-modal-frame {
    position: relative;
    max-height: calc(100svh - 40px);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
    border: 8px solid #101416;
    background:
      linear-gradient(122deg, rgba(255, 255, 255, 0.9) 0 18%, transparent 18%),
