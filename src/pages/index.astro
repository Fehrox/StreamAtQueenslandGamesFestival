    -webkit-text-fill-color: var(--ready-word-fill);
  }

  .ready-copy span::after,
  .ready-copy small::after {
    content: attr(data-ready-word);
    position: absolute;
    z-index: 1;
    inset: 0;
    display: block;
    pointer-events: none;
    color: transparent;
    background:
      linear-gradient(
        105deg,
        transparent 0 31%,
        rgba(255, 244, 112, 0) 40%,
        rgba(255, 244, 112, 0.9) 46%,
        #fff 50%,
        rgba(255, 244, 112, 0.9) 54%,
        rgba(255, 244, 112, 0) 60%,
        transparent 100%
      );
    background-size: 360% 100%;
    background-position: 150% 0;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    text-shadow: none;
    mix-blend-mode: screen;
