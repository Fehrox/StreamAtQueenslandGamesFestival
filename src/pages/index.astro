      const eventInfoModal =
        document.querySelector<HTMLDialogElement>("[data-event-info-modal]");
      const eventInfoCloseButtons =
        document.querySelectorAll<HTMLButtonElement>("[data-event-info-close]");
      const eventCountdown = document.querySelector<HTMLElement>("[data-event-countdown]");
      const mapLinks = document.querySelectorAll<HTMLAnchorElement>("[data-map-link]");
      const confirmPanel = document.querySelector<HTMLElement>("[data-confirm-panel]");
      const confirmOpenButtons = document.querySelectorAll<HTMLButtonElement>("[data-confirm-open]");
      const confirmModal = document.querySelector<HTMLDialogElement>("[data-confirm-modal]");
      const confirmForm = document.querySelector<HTMLFormElement>("[data-confirm-form]");
      const confirmModalCloseButtons = document.querySelectorAll<HTMLButtonElement>(
        "[data-confirm-modal-close]",
      );
      const confirmStreamerSelect = document.querySelector<HTMLSelectElement>(
        "[data-confirm-streamer-select]",
