---
import {
  getStreamerUrlSlug,
  streamers,
  type StreamerProfile,
} from "@data/streamers";

const rosterColumns = 13;
const siteUrl = Astro.site ?? new URL("https://streamatqueenslandgamesfestival.com/");
const { selectedStreamer } = Astro.props as { selectedStreamer?: StreamerProfile };
const pageTitle = selectedStreamer
  ? `${selectedStreamer.name} | QGF Streamer Invite`
  : "Queensland Games Festival Streamer Invite";
const pageDescription = selectedStreamer
  ? `Queensland Games Festival streamer invite for ${selectedStreamer.name}.`
  : "Join the Queensland Games Festival creator invite for indie game streams, Twitch Connect, and creator sessions.";
const pageUrl = new URL(
  selectedStreamer ? `/${getStreamerUrlSlug(selectedStreamer.name)}/` : "/",
  siteUrl,
).toString();
const genericSocialImagePath = "/social/qgf-streamer-invite-og.png";
const socialImagePath =
  selectedStreamer?.fallbackImage || selectedStreamer?.image || genericSocialImagePath;
const usesGenericSocialImage = socialImagePath === genericSocialImagePath;
const socialImageUrl = socialImagePath ? new URL(socialImagePath, siteUrl).toString() : "";
const socialImageAlt =
  selectedStreamer && !usesGenericSocialImage
    ? `${selectedStreamer.name} profile picture`
    : "Illustrated Queensland Games Festival streamer invite preview";
const brisbanePowerhouseMapUrl =
  "https://www.google.com/maps/search/?api=1&query=Brisbane%20Powerhouse%2C%20Brisbane%20QLD";
const confirmationQuestions = [
  {
    id: "streaming-station",
    name: "streamingStation",
    label: "Want to stream indie games at a Stream Station?",
  },
  {
    id: "twitch-connect",
    name: "twitchConnect",
    label: "Will you be attending Twitch Connect?",
  },
  {
    id: "panel-interest",
    name: "panelInterest",
    label: "Are you interested in participating in a panel?",
  },
  {
    id: "irl-streaming",
    name: "irlStreaming",
    label: "Will you be IRL streaming the event?",
  },
];

const profileIconCutouts = [
  "/profile-icons/parrot.png",
  "/profile-icons/possum.png",
  "/profile-icons/gamepad.png",
  "/profile-icons/joystick.png",
  "/profile-icons/hexagon.png",
  "/profile-icons/kangaroo-gamepad.png",
  "/profile-icons/southern-cross.png",
  "/profile-icons/wattle.png",
  "/profile-icons/pixel-opal.png",
  "/profile-icons/flat-white-controller.png",
  "/profile-icons/arcade-cabinet.png",
  "/profile-icons/gumleaf-brush.png",
  "/profile-icons/stream-mic.png",
  "/profile-icons/stream-chat-crt.png",
  "/profile-icons/lan-plug.png",
];

const getStableIconIndex = (key: string) => {
  let hash = 0;

  for (const character of key) {
    hash = (hash * 31 + character.charCodeAt(0)) >>> 0;
  }

  return hash % profileIconCutouts.length;
};

const getStreamerProfileIcon = (streamer: (typeof streamers)[number]) => {
  const key = streamer.twitchHandle || streamer.name || streamer.id;

  return profileIconCutouts[getStableIconIndex(key)];
};

const streamerVerificationProfiles = streamers.map(
  ({
    id,
    name,
    twitchHandle,
    image,
    fallbackImage,
    nintendoImage,
    profileImage,
    profileUrl,
    styledImage,
  }) => ({
    id,
    name,
    image: image ?? "",
    fallbackImage: fallbackImage ?? "",
    nintendoImage: nintendoImage ?? "",
    profileImage: profileImage ?? "",
    profileUrl: profileUrl ?? "",
    styledImage: styledImage ?? "",
    twitchHandle: twitchHandle ?? "",
  }),
);
const streamerVerificationProfileJson = JSON.stringify(streamerVerificationProfiles).replace(
  /</g,
  "\\u003c",
);

type CreatorProfilePlatform = "twitch" | "youtube";

const twitchProfileUrlPattern = /^https:\/\/(www\.)?twitch\.tv\/[^/?#]+/i;
const youtubeProfileUrlPattern =
  /^https:\/\/(www\.)?youtube\.com\/(@[^/?#]+|c\/[^/?#]+|channel\/[^/?#]+|user\/[^/?#]+)/i;

const getCreatorProfileLink = (
  twitchHandle = "",
  profileUrl = "",
): { platform: CreatorProfilePlatform | ""; url: string } => {
  const normalizedHandle = twitchHandle.trim().replace(/^@+/, "");

  if (normalizedHandle) {
    return {
      platform: "twitch",
      url: `https://www.twitch.tv/${encodeURIComponent(normalizedHandle)}`,
    };
  }

  const normalizedProfileUrl = profileUrl.trim();

  if (twitchProfileUrlPattern.test(normalizedProfileUrl)) {
    return { platform: "twitch", url: normalizedProfileUrl };
  }

  if (youtubeProfileUrlPattern.test(normalizedProfileUrl)) {
    return { platform: "youtube", url: normalizedProfileUrl };
  }

  return { platform: "", url: "" };
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content={pageDescription}
    />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Queensland Games Festival" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    {
      socialImageUrl && (
        <>
          <meta property="og:image" content={socialImageUrl} />
          <meta property="og:image:secure_url" content={socialImageUrl} />
          <meta property="og:image:alt" content={socialImageAlt} />
          {usesGenericSocialImage && (
            <>
              <meta property="og:image:type" content="image/png" />
              <meta property="og:image:width" content="1200" />
              <meta property="og:image:height" content="630" />
            </>
          )}
        </>
      )
    }
    <meta
      name="twitter:card"
      content={socialImageUrl ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {
      socialImageUrl && (
        <>
          <meta name="twitter:image" content={socialImageUrl} />
          <meta name="twitter:image:alt" content={socialImageAlt} />
        </>
      )
    }
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <main class="viewport" aria-label="Queensland Games Festival streamer signup">
      <section class="stage" aria-label="Streamer selection screen">
        <header class="top-bar">
          <div class="nav-plate">
            <button
              type="button"
              class="back-action"
              data-back-arrow
              aria-label="Back to Queensland Games Festival"
            >
              <span class="back-icon" aria-hidden="true"></span>
            </button>
            <button
              type="button"
              class="info-action"
              data-event-info-open
              aria-label="Show Queensland Games Festival event information"
            >
              <img
                class="event-info-icon"
                src="/icons/EventInfoIcon.png"
                alt=""
                aria-hidden="true"
                draggable="false"
              />
            </button>
          </div>
          <div class="title-tab">
            <span class="title-crop title-crop-left"></span>
            <h1>QGF Streamer Invite</h1>
            <span class="title-caret"></span>
          </div>
        </header>

        <section
          class="roster"
          style={`--roster-columns: ${rosterColumns}`}
          aria-label="Streamer roster placeholders"
        >
          {
            streamers.map((streamer, index) => (
              <article
                class={`tile tile-${streamer.status}`}
                style={`--tile-index: ${index}`}
                data-streamer-card
                aria-label={`${streamer.name} streamer slot`}
                role="button"
                tabindex="0"
                data-desktop-streamer-card
                data-streamer-id={streamer.id}
                data-streamer-name={streamer.name}
                data-streamer-key={streamer.twitchHandle}
                data-streamer-url-slug={
                  streamer.image || streamer.twitchHandle
                    ? getStreamerUrlSlug(streamer.name)
                    : ""
                }
                data-streamer-image={streamer.image ?? ""}
                data-streamer-fallback-image={streamer.fallbackImage ?? ""}
                data-streamer-profile-image={streamer.profileImage ?? ""}
                data-streamer-styled-image={streamer.styledImage ?? ""}
                data-streamer-nintendo-image={streamer.nintendoImage ?? ""}
                data-streamer-profile-link-url={getCreatorProfileLink(
                  streamer.twitchHandle,
                  streamer.profileUrl,
                ).url}
                data-streamer-profile-link-platform={getCreatorProfileLink(
                  streamer.twitchHandle,
                  streamer.profileUrl,
                ).platform}
                data-streamer-profile-icon={getStreamerProfileIcon(streamer)}
                aria-pressed="false"
              >
                <div class="portrait" aria-hidden="true">
                  {
                    streamer.image ? (
                      <img
                        src={streamer.image}
                        alt=""
                        loading="lazy"
                        data-fallback-src={streamer.fallbackImage ?? undefined}
                        data-styled-streamer-image={
                          streamer.profileImage && streamer.image !== streamer.profileImage
                            ? "true"
                            : undefined
                        }
                      />
                    ) : (
                      <>
                        <span class="portrait-shape portrait-shape-a" />
                        <span class="portrait-shape portrait-shape-b" />
                        <span class="portrait-head" />
                        <span class="portrait-body" />
                      </>
                    )
                  }
                </div>
                <div class="tile-shine" aria-hidden="true" />
                <h2>{streamer.name}</h2>
                <img
                  class="selection-marker"
                  src="/cursors/P1Marker.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </article>
            ))
          }
        </section>

        <section class="ready-overlay" aria-hidden="true">
          <div class="ready-panel">
            <span class="ready-rail ready-rail-top"></span>
            <div class="ready-banner">
              <span class="ready-red-wedge"></span>
              <span class="ready-yellow-wedge"></span>
              <p class="ready-copy">
                <span data-ready-word="READY">READY</span>
                <small data-ready-word="to">to</small>
                <span data-ready-word="STREAM!">STREAM!</span>
              </p>
            </div>
            <span class="ready-rail ready-rail-bottom"></span>
          </div>
        </section>

        <section class="bottom-dock" aria-label="Signup panel">
          <canvas
            class="dock-shader"
            data-dock-shader
            aria-hidden="true"
          ></canvas>
          <article class="player-panel player-panel-primary">
            <div class="panel-shadow" aria-hidden="true"></div>
            <div class="panel-background" aria-hidden="true">
              <div class="panel-slash"></div>
            </div>
            <div class="panel-portrait" aria-hidden="true" data-desktop-selected-portrait>
            </div>
            <div class="player-red-card">
              <img
                class="profile-cutout-icon"
                alt=""
                aria-hidden="true"
                draggable="false"
                data-selected-profile-icon
                hidden
              />
              <h2 data-selected-name></h2>
              <div class="player-info">
                <a
                  class="creator-profile-link"
                  data-selected-profile-link
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Open creator profile"
                  aria-label="Open selected creator profile"
                  aria-disabled="true"
                  data-profile-link-disabled
                  tabindex="-1"
                >
                  <img
                    data-selected-profile-link-icon
                    src="/icons/TwitchGlitchWhite.svg"
                    alt=""
                    aria-hidden="true"
                    draggable="false"
                  />
                </a>
                <strong>0%</strong>
              </div>
              <div class="controller-strip">
                <span class="signal-bars" aria-hidden="true">
                  <i></i><i></i><i></i><i></i>
                </span>
                <img
                  class="controller-icon"
                  src="/icons/PlayerControllerIcon.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
                <strong>P1</strong>
              </div>
            </div>
          </article>

          <article class="player-panel player-panel-random" data-confirm-panel>
            <div class="question-mark" aria-hidden="true">?</div>
            <div class="random-copy">
              <h2 class="confirm-copy">Confirm Attendance</h2>
              <div class="invite-context" aria-label="Event details">
                <h2>You're invited!</h2>
                <div class="event-details">
                  <div class="event-detail-row">
                    <span class="event-detail-label">Date</span>
                    <span class="event-detail-value">26th and 27th of June</span>
                  </div>
                  <a
                    class="event-detail-row event-map-button"
                    href={brisbanePowerhouseMapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-map-link
                    aria-label="Open Brisbane Powerhouse in Google Maps"
                  >
                    <span class="event-detail-label">Location</span>
                    <span class="event-detail-value">Brisbane Powerhouse</span>
                  </a>
                </div>
              </div>
              <button
                type="button"
                class="twitch-confirm-button"
                data-twitch-confirm
                hidden
                aria-label="Confirm selected creator with Twitch"
              >
                <span class="twitch-wordmark" aria-hidden="true">
                  <img
                    class="twitch-icon"
                    src="/icons/TwitchGlitchWhite.svg"
                    alt=""
                    draggable="false"
                  />
                  <span>Twitch</span>
                </span>
                <span class="twitch-confirm-label">Confirm with Twitch</span>
              </button>
            </div>
            <aside class="side-buttons" aria-hidden="true">
              <span>+1</span>
              <span></span>
            </aside>
          </article>
        </section>
      </section>

      <section class="ready-overlay mobile-ready-overlay" aria-hidden="true">
        <div class="ready-panel">
          <span class="ready-rail ready-rail-top"></span>
          <div class="ready-banner">
            <span class="ready-red-wedge"></span>
            <span class="ready-yellow-wedge"></span>
            <p class="ready-copy">
              <span data-ready-word="READY">READY</span>
              <small data-ready-word="to">to</small>
              <span data-ready-word="STREAM!">STREAM!</span>
            </p>
          </div>
          <span class="ready-rail ready-rail-bottom"></span>
        </div>
      </section>

      <section class="mobile-layout" aria-label="Mobile streamer signup">
        <header class="mobile-top-bar">
          <div class="mobile-nav-plate">
            <button
              type="button"
              class="mobile-back-action"
              data-back-arrow
              aria-label="Back to Queensland Games Festival"
            >
              <span class="mobile-back-icon" aria-hidden="true"></span>
            </button>
            <button
              type="button"
              class="mobile-info-action"
              data-event-info-open
              aria-label="Show Queensland Games Festival event information"
            >
              <img
                class="event-info-icon"
                src="/icons/EventInfoIcon.png"
                alt=""
                aria-hidden="true"
                draggable="false"
              />
            </button>
          </div>
          <div class="mobile-title-tab">
            <h1>QGF Streamer Invite</h1>
            <span class="mobile-title-caret"></span>
          </div>
        </header>

        <section class="mobile-roster" aria-label="Streamer roster placeholders">
          {
            streamers.map((streamer, index) => (
              <button
                type="button"
                class={`mobile-tile mobile-tile-${streamer.status}`}
                style={`--tile-index: ${index}`}
                data-mobile-streamer-card
                data-streamer-id={streamer.id}
                data-streamer-name={streamer.name}
                data-streamer-key={streamer.twitchHandle}
                data-streamer-url-slug={
                  streamer.image || streamer.twitchHandle
                    ? getStreamerUrlSlug(streamer.name)
                    : ""
                }
                data-streamer-image={streamer.image ?? ""}
                data-streamer-fallback-image={streamer.fallbackImage ?? ""}
                data-streamer-profile-image={streamer.profileImage ?? ""}
                data-streamer-styled-image={streamer.styledImage ?? ""}
                data-streamer-nintendo-image={streamer.nintendoImage ?? ""}
                data-streamer-profile-link-url={getCreatorProfileLink(
                  streamer.twitchHandle,
                  streamer.profileUrl,
                ).url}
                data-streamer-profile-link-platform={getCreatorProfileLink(
                  streamer.twitchHandle,
                  streamer.profileUrl,
                ).platform}
                data-streamer-profile-icon={getStreamerProfileIcon(streamer)}
                aria-pressed="false"
              >
                <span class="mobile-portrait" aria-hidden="true">
                  {
                    streamer.image ? (
                      <img
                        src={streamer.image}
                        alt=""
                        loading="lazy"
                        data-fallback-src={streamer.fallbackImage ?? undefined}
                        data-styled-streamer-image={
                          streamer.profileImage && streamer.image !== streamer.profileImage
                            ? "true"
                            : undefined
                        }
                      />
                    ) : (
                      <>
                        <span class="mobile-portrait-shape mobile-portrait-shape-a" />
                        <span class="mobile-portrait-shape mobile-portrait-shape-b" />
                        <span class="mobile-portrait-head" />
                        <span class="mobile-portrait-body" />
                      </>
                    )
                  }
                </span>
                <span class="mobile-tile-shine" aria-hidden="true"></span>
                <span class="mobile-tile-name">{streamer.name}</span>
                <img
                  class="selection-marker"
                  src="/cursors/P1Marker.png"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
              </button>
            ))
          }
        </section>

        <section class="mobile-cta" data-mobile-cta hidden aria-live="polite">
          <div class="mobile-cta-panel">
            <div class="mobile-cta-portrait" aria-hidden="true" data-mobile-selected-portrait>
            </div>
            <div class="mobile-cta-card">
              <img
                class="profile-cutout-icon"
                alt=""
                aria-hidden="true"
                draggable="false"
                data-selected-profile-icon
                hidden
              />
              <h2 data-mobile-selected-name></h2>
              <div class="mobile-player-info">
                <span>Streamer</span>
                <strong>0%</strong>
              </div>
              <div class="mobile-invite-context" aria-label="Event details">
                <p>You're invited!</p>
                <span>26th and 27th of June</span>
                <a
                  class="mobile-map-button"
                  href={brisbanePowerhouseMapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-map-link
                  aria-label="Open Brisbane Powerhouse in Google Maps"
                >
                  Brisbane Powerhouse
                </a>
              </div>
              <button
                type="button"
                class="mobile-twitch-button"
                data-confirm-open
                aria-disabled="true"
              >
                <img
                  class="mobile-twitch-icon"
                  src="/icons/TwitchGlitchWhite.svg"
                  alt=""
                  aria-hidden="true"
                  draggable="false"
                />
                <span>Confirm with Twitch</span>
              </button>
            </div>
          </div>
        </section>
      </section>
    </main>

    <script
      is:inline
      type="application/json"
      data-streamer-verification-profiles
      set:html={streamerVerificationProfileJson}
    ></script>

    <dialog
      id="event-info-modal"
      class="confirm-modal event-info-modal"
      data-event-info-modal
      aria-labelledby="event-info-modal-title"
    >
      <section class="confirm-modal-frame event-info-modal-frame">
        <header class="confirm-modal-header event-info-modal-header">
          <div class="confirm-modal-brand event-info-modal-brand" aria-hidden="true">
            <img
              src="/icons/EventInfoIcon.png"
              alt=""
              draggable="false"
            />
            <span>QGF</span>
          </div>
          <h2 id="event-info-modal-title">Event Info</h2>
          <button
            type="button"
            class="confirm-modal-close"
            data-event-info-close
            aria-label="Close event information"
          >
            X
          </button>
        </header>

        <div class="confirm-modal-body event-info-modal-body">
          <section class="event-info-intro" aria-label="Streamer Summit overview">
            <p class="event-info-kicker">Let's Play Streamer Summit</p>
            <p class="event-info-lede">
              Screen Queensland is inviting selected Australian streamers and content creators to
              join a new creator event inside Queensland Games Festival 2026.
            </p>
            <div class="event-info-facts" aria-label="Event details">
              <div class="event-info-fact">
                <span>Where</span>
                <strong>Brisbane Powerhouse, Brisbane</strong>
              </div>
              <div class="event-info-fact">
                <span>When</span>
                <strong>26-27 June 2026</strong>
                <small
                  class="event-info-countdown"
                  data-event-countdown
                  aria-label="Countdown to the first day of the event"
                >
                  Counting down...
                </small>
              </div>
              <div class="event-info-fact">
                <span>Games</span>
                <strong>30+ upcoming indie games</strong>
              </div>
            </div>
          </section>

          <section class="event-info-section" aria-label="Creator opportunities">
            <h3>Creator Opportunities</h3>
            <ul class="event-info-list">
              <li>Create content around upcoming indie games.</li>
              <li>Meet developers, publishers, investors, creators, and platform guests.</li>
              <li>Join creator-focused panels, live activities, and festival-floor streams.</li>
              <li>Attend Queensland's first Twitch Connect networking event.</li>
            </ul>
          </section>

          <section class="event-info-schedule" aria-label="Event schedule">
            <article class="event-info-card">
              <span>Friday 26 June</span>
              <h3>Growing a Community on Twitch</h3>
              <p class="event-info-time">2:00pm - 3:00pm</p>
              <p>
                Panelists will share practical advice, lessons learned, and creator insights about
                building a sustainable gaming community.
              </p>
            </article>

            <article class="event-info-card">
              <span>Friday 26 June</span>
              <h3>Devs vs Streamers: Super Smash Bros Showdown</h3>
              <p class="event-info-time">4:00pm - 4:30pm</p>
              <p>
                Team Streamers faces Queensland game developers in a live Super Smash Bros battle
                for bragging rights.
              </p>
            </article>

            <article class="event-info-card">
              <span>Saturday 27 June</span>
              <h3>Creator Streaming Stations</h3>
              <p>
                One-hour creator sessions include a pre-configured OBS station, camera,
                microphone or headset, game capture, chat display, local recording, and staff tech
                support.
              </p>
            </article>

            <article class="event-info-card">
              <span>Saturday Evening</span>
              <h3>Twitch Connect</h3>
              <p>
                Twitch Partners and invited creators can meet fellow streamers, developers,
                industry professionals, and Twitch representatives.
              </p>
            </article>
          </section>

          <section class="event-info-eoi" aria-label="Expression of interest">
            <h3>Expression of Interest</h3>
            <p>
              Interested in joining as a panelist, competitor, streamer, or attendee? Contact
              <strong>Jed Dawson</strong> at
              <a href="mailto:jdawson@screenqld.com.au">jdawson@screenqld.com.au</a>.
            </p>
            <p>Travel funding support is available for selected interstate panelists.</p>
          </section>
        </div>
      </section>

      <div
        class="custom-cursor custom-cursor-modal"
        aria-hidden="true"
        data-custom-cursor
        hidden
      >
        <div class="custom-cursor-art">
          <img
            class="custom-cursor-hand custom-cursor-hand-marker"
            src="/cursors/MarkerHand.png"
            alt=""
            draggable="false"
          />
          <img
            class="custom-cursor-hand custom-cursor-hand-pointer"
            src="/cursors/PointerHand.png"
            alt=""
            draggable="false"
          />
          <img
            class="custom-cursor-hand custom-cursor-hand-open"
            src="/cursors/OpenHand.png"
            alt=""
            draggable="false"
          />
          <img
            class="custom-cursor-p1"
            src="/cursors/P1.png"
            alt=""
            draggable="false"
          />
        </div>
      </div>
    </dialog>

    <dialog
      class="confirm-modal"
      data-confirm-modal
      aria-labelledby="confirm-modal-title"
    >
      <form class="confirm-modal-frame" data-confirm-form method="post">
        <header class="confirm-modal-header">
          <div class="confirm-modal-brand" aria-hidden="true">
            <img
              src="/icons/TwitchGlitchWhite.svg"
              alt=""
              draggable="false"
            />
            <span>Twitch</span>
          </div>
          <h2 id="confirm-modal-title">Creator Confirmation</h2>
          <button
