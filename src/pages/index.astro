  .custom-cursor-pressed .custom-cursor-art {
    transform: translate(-28%, -15%) scale(0.92);
  }

  .custom-cursor-hand,
  .custom-cursor-p1 {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
