  :global(html.custom-cursor-enabled),
  :global(html.custom-cursor-enabled *) {
    cursor: none !important;
  }

  .custom-cursor {
    position: fixed;
    z-index: 1000;
    left: 0;
    top: 0;
    width: 108px;
    height: 108px;
    opacity: 0;
    pointer-events: none;
    transform: translate3d(-200px, -200px, 0);
    transition: opacity 80ms ease;
    will-change: transform;
  }

  .custom-cursor[hidden] {
    display: none;
  }

  .custom-cursor-visible {
    opacity: 1;
  }

  .custom-cursor-art {
    position: relative;
    width: 100%;
    height: 100%;
    transform: translate(-28%, -15%);
    transform-origin: 28% 15%;
    transition: transform 80ms ease;
  }

  .custom-cursor-pressed .custom-cursor-art {
    transform: translate(-28%, -15%) scale(0.92);
  }

  .custom-cursor-hand,
  .custom-cursor-p1 {
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  .custom-cursor-hand {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 120ms ease;
  }

  .custom-cursor-hand-marker,
  .custom-cursor-hand-open,
  .custom-cursor-p1 {
    opacity: 0;
  }

  :global(html.custom-cursor-over-streamer-card) .custom-cursor-hand-pointer {
    opacity: 0;
  }

  :global(html.custom-cursor-over-streamer-card) .custom-cursor-hand-marker,
  :global(html.custom-cursor-over-streamer-card) .custom-cursor-p1 {
    opacity: 1;
  }

  :global(html.has-streamer-selected.custom-cursor-over-streamer-card)
    .custom-cursor-hand-marker,
  :global(html.has-streamer-selected.custom-cursor-over-streamer-card) .custom-cursor-p1 {
    opacity: 0;
  }

  :global(html.has-streamer-selected.custom-cursor-over-streamer-card)
    .custom-cursor-hand-open {
    opacity: 1;
  }

  .custom-cursor-p1 {
    position: absolute;
    right: -10%;
    bottom: -10%;
    width: 42%;
    height: 42%;
    object-fit: contain;
    transition: opacity 120ms ease;
  }

