  .ready-banner::before {
    z-index: 0;
    inset: 0;
    background: #090a0b;
    box-shadow:
      inset 0 0 0 5px rgba(255, 255, 255, 0.14),
      inset 0 -12px 0 rgba(0, 0, 0, 0.38),
