  @media (max-width: 900px) {
    :global(html),
    :global(body) {
      min-height: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      background: #080d10;
    }

    .viewport {
      width: 100%;
      min-height: 100svh;
      height: auto;
      overflow: visible;
      background:
        linear-gradient(150deg, transparent 0 20%, rgba(107, 185, 232, 0.9) 20% 42%, transparent 42%),
        linear-gradient(24deg, transparent 0 35%, rgba(21, 156, 240, 0.9) 35% 58%, transparent 58%),
        linear-gradient(180deg, var(--edge-blue-light) 0%, var(--edge-blue-mid) 30%, var(--edge-blue-light) 58%, var(--edge-blue-deep) 78%, var(--edge-blue-light) 100%);
    }

    .stage {
      display: none;
    }

    .mobile-layout {
      display: block;
      width: 100%;
      min-height: 100svh;
      padding: 86px 8px 28px;
    }

    :global(html.has-streamer-selected) .mobile-layout {
      padding-bottom: calc(374px + max(12px, env(safe-area-inset-bottom)));
    }

    .mobile-ready-overlay {
      position: fixed;
      z-index: 45;
      display: block;
      inset: 0;
    }

    .mobile-ready-overlay .ready-panel {
      --mobile-ready-top-rail: clamp(16px, 4vw, 28px);
      --mobile-ready-bottom-rail: clamp(28px, 7vw, 46px);
      --mobile-ready-side-wedge: clamp(58px, 16vw, 126px);
      --ready-panel-depth: translateX(-50%) perspective(780px) rotateY(-8deg) rotateZ(-1.3deg) scaleX(1);
      left: 50%;
      top: clamp(150px, 28svh, 260px);
      width: min(960px, calc(100vw + 160px));
      height: clamp(132px, 25vw, 214px);
      filter: drop-shadow(0 10px 0 rgba(0, 0, 0, 0.54));
      transform-origin: 76% 50%;
    }

    .mobile-ready-overlay .ready-panel::before {
      top: calc(100% - var(--mobile-ready-bottom-rail) - clamp(20px, 5vw, 36px));
      height: clamp(20px, 5vw, 36px);
    }

    .mobile-ready-overlay .ready-rail-top {
      height: var(--mobile-ready-top-rail);
    }

    .mobile-ready-overlay .ready-rail-bottom {
      top: calc(100% - var(--mobile-ready-bottom-rail));
      height: var(--mobile-ready-bottom-rail);
    }

    .mobile-ready-overlay .ready-banner {
      left: var(--mobile-ready-side-wedge);
      right: var(--mobile-ready-side-wedge);
      top: var(--mobile-ready-top-rail);
      bottom: var(--mobile-ready-bottom-rail);
      height: auto;
      transform: translateY(3px) skewY(-1deg);
    }

    .mobile-ready-overlay .ready-red-wedge,
    .mobile-ready-overlay .ready-yellow-wedge {
      top: clamp(-17px, -3.4vw, -10px);
      bottom: clamp(-17px, -3.4vw, -10px);
    }

    .mobile-ready-overlay .ready-red-wedge {
      left: calc(var(--mobile-ready-side-wedge) * -1);
      width: calc(var(--mobile-ready-side-wedge) + clamp(34px, 9vw, 76px));
    }

    .mobile-ready-overlay .ready-yellow-wedge {
      right: calc(var(--mobile-ready-side-wedge) * -1);
      width: calc(var(--mobile-ready-side-wedge) + clamp(42px, 11vw, 92px));
    }

    .mobile-ready-overlay .ready-copy {
      inset: 0 clamp(8px, 2vw, 18px);
      gap: clamp(6px, 1.8vw, 18px);
      font-size: clamp(38px, 9.4vw, 82px);
      text-shadow:
        -3px -3px 0 #050505,
        3px -3px 0 #050505,
        -3px 3px 0 #050505,
        3px 3px 0 #050505,
        0 7px 0 rgba(0, 0, 0, 0.42),
        7px 10px 0 rgba(0, 0, 0, 0.5);
      transform: translateY(12px) skewX(-8deg) scaleX(0.92);
    }

    :global(html.has-streamer-selected) .mobile-ready-overlay .ready-copy,
    :global(html.ready-overlay-exiting) .mobile-ready-overlay .ready-copy {
      transform: translateY(0) skewX(-8deg) scaleX(0.92);
    }

    .mobile-ready-overlay .ready-copy small {
      font-size: clamp(18px, 4.4vw, 38px);
    }

    .mobile-top-bar {
      position: fixed;
      z-index: 20;
      left: 0;
      right: 0;
      top: 0;
