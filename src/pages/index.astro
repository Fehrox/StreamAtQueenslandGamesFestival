      0 0 18px rgba(0, 0, 0, 0.42);
    opacity: 0;
    transform: scaleX(0.02);
    transform-origin: left center;
    transition:
      opacity 110ms ease,
      transform 220ms cubic-bezier(0.2, 0.86, 0.24, 1);
  }

  .ready-banner::after {
    z-index: 1;
    inset: 0;
    background:
      linear-gradient(105deg, transparent 0 22%, rgba(255, 255, 255, 0.09) 23% 31%, transparent 32% 100%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.11), transparent 32%);
    opacity: 0;
    transform: scaleX(0.02);
    transform-origin: left center;
    transition:
      opacity 110ms ease,
      transform 220ms cubic-bezier(0.2, 0.86, 0.24, 1);
  }

  :global(html.has-streamer-selected) .ready-banner::before,
  :global(html.has-streamer-selected) .ready-banner::after,
  :global(html.ready-overlay-exiting) .ready-banner::before,
