      const verificationChoiceWarning = document.querySelector<HTMLElement>(
        "[data-verification-choice-warning]",
      );
      const confirmWithTwitchButton = document.querySelector<HTMLButtonElement>(
        "[data-confirm-with-twitch]",
      );
