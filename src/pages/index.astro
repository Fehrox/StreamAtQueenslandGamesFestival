      const setSelectedPortrait = (
        target: Element | null,
        image: string,
        fallbackImage: string,
        isGeneratedVariant = false,
      ) => {
        if (!(target instanceof HTMLElement)) {
          return;
        }

        target.classList.toggle("selected-portrait-has-image", Boolean(image));

        if (!image) {
          target.removeAttribute("data-current-portrait-image");
          target.replaceChildren();
          return;
        }

        const currentImage =
          target.getAttribute("data-current-portrait-image") ||
          target.querySelector("img")?.getAttribute("src") ||
          "";

        if (currentImage === image) {
          const currentImg = target.querySelector<HTMLImageElement>("img");

          if (currentImg) {
            setStreamerImageElement(currentImg, {
              image,
              fallbackImage,
              isGeneratedVariant,
            });
          }

          return;
        }

        target.setAttribute("data-current-portrait-image", image);
        const previousChildren = Array.from(target.children);
        const img = document.createElement("img");
        img.alt = "";
        img.decoding = "async";
        img.className = "portrait-crossfade-enter";
        setStreamerImageElement(img, { image, fallbackImage, isGeneratedVariant });
        wireImageFallback(img, false);
        target.append(img);

        window.requestAnimationFrame(() => {
          img.classList.add("portrait-crossfade-enter-active");

          previousChildren.forEach((child) => {
            child.classList.add("portrait-crossfade-exit");
            child.classList.add("portrait-crossfade-exit-active");
          });
        });

        window.setTimeout(() => {
          previousChildren.forEach((child) => child.remove());
          img.classList.remove("portrait-crossfade-enter", "portrait-crossfade-enter-active");
        }, portraitFadeMs + 40);
      };

