    <script>
      const setStageScale = () => {
        const scale = Math.min(window.innerWidth / 1920, window.innerHeight / 1080);
        document.documentElement.style.setProperty("--stage-scale", String(scale));
      };

      setStageScale();
      window.addEventListener("resize", setStageScale, { passive: true });

      type StreamerVerificationProfile = {
        id: string;
        name: string;
        image: string;
        fallbackImage: string;
        nintendoImage: string;
        profileImage: string;
        profileUrl: string;
        styledImage: string;
        twitchHandle: string;
      };

      type StreamerImageMode = "profile" | "styled" | "nintendo";

      type StreamerImageTarget = {
        image: string;
        fallbackImage: string;
        isGeneratedVariant: boolean;
      };

      type ConfirmationDetails = {
        creatorId: string;
        creatorName: string;
        creatorEmail: string;
        answers: Record<string, string>;
        expectedTwitchHandle: string;
        savedAt: string;
      };

      type PendingTwitchVerification = ConfirmationDetails & {
        state: string;
        redirectUri: string;
        attemptedRedirectUris?: string[];
      };

      type VerificationResultStatus =
        | "verified"
        | "mismatch"
        | "unverified"
        | "cancelled"
        | "failed";

      const eoiFormUrl = import.meta.env.PUBLIC_GOOGLE_EOI_FORM_URL || "";
